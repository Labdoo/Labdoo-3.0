# PROJECT SETTINGS

# ENVIRONMENT (dev, pre, prod)
ENVIRONMENT=dev

# DATABASE
# Change in production
DB_NAME=drupal
DB_USER=db
DB_PASSWORD=db
DB_HOST=db
DB_PORT=3306
DB_DRIVER=mysql

# SECONDARY DATABASE
#SECONDARY_DB_KEY=migrate
#SECONDARY_DB_NAME=db
#SECONDARY_DB_USER=db
#SECONDARY_DB_PASSWORD=db
#SECONDARY_DB_HOST=secondary_host
#SECONDARY_DB_PORT=3306
#SECONDARY_DB_DRIVER=mysql

# TRUSTED HOST PATTERNS, if there are more than one, separate them with a comma and without spaces
TRUSTED_HOST_PATTERNS=.*

# SMTP CREDENTIALS
#SMTP_USER=
#SMTP_PASSWORD=

# Needed for docker
DOMAIN=project.local

# Optional for docker (Do not use the defaults in production)
#USERID=1000
#GROUPID=1000
#USERNAME=solucionex
#DB_ROOT_PASSWORD=db
#TZ=Europe/Madrid
#MARIADB_VERSION=10.5
#MYSQL_VERSION=8
#NODE_VERSION=16

# Autogenerated variables:
HASH_SALT=
PROJECT_NAME=project
DRUSH_OPTIONS_URI=https://project.local
