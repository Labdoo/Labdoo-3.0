# PROJECT SETTINGS

# ENVIRONMENT (dev, pre, prod)
ENVIRONMENT=dev

# DATABASE
# Change in production
DB_NAME=drupal
DB_USER=db
DB_PASSWORD=db
DB_HOST=db
DB_PORT=3306
DB_DRIVER=mysql

# SECONDARY DATABASE
#SECONDARY_DB_KEY=migrate
#SECONDARY_DB_NAME=db
#SECONDARY_DB_USER=db
#SECONDARY_DB_PASSWORD=db
#SECONDARY_DB_HOST=secondary_host
#SECONDARY_DB_PORT=3306
#SECONDARY_DB_DRIVER=mysql

# TRUSTED HOST PATTERNS, if there are more than one, separate them with a comma and without spaces
TRUSTED_HOST_PATTERNS=.*

# SMTP CREDENTIALS
#SMTP_USER=
#SMTP_PASSWORD=

# Needed for docker
DOMAIN=project.local

# Optional for docker (Do not use the defaults in production)
#USERID=1000
#GROUPID=1000
#USERNAME=solucionex
#DB_ROOT_PASSWORD=db
#TZ=Europe/Madrid
#MARIADB_VERSION=10.5
#MYSQL_VERSION=8
#NODE_VERSION=16

# Autogenerated variables:
HASH_SALT=
PROJECT_NAME=project
DRUSH_OPTIONS_URI=https://project.local

# Local Test Lab environment selector.
LABDOO_TEST_ENVIRONMENTS=local
LABDOO_TEST_DEFAULT_ENV=local
LABDOO_TEST_ENV_LOCAL_NAME=Local test clone
LABDOO_TEST_ENV_LOCAL_URL=http://127.0.0.1:18411
LABDOO_TEST_ENV_LOCAL_MODE=isolated

# Add a remote test/staging environment by listing its id and defining its
# HTTPS URL. Remote Playwright runs are read-only smoke checks. Enable k6 only
# when the selected environment can safely handle the 13-minute load profile.
# LABDOO_TEST_ENVIRONMENTS=local,staging
# LABDOO_TEST_ENV_STAGING_NAME=Staging
# LABDOO_TEST_ENV_STAGING_URL=https://staging.example.org
# LABDOO_TEST_ENV_STAGING_MODE=readonly
# LABDOO_TEST_ENV_STAGING_ALLOW_LIGHTHOUSE=1
# LABDOO_TEST_ENV_STAGING_ALLOW_K6=0
# LABDOO_TEST_ENV_STAGING_HTTP_USER=
# LABDOO_TEST_ENV_STAGING_HTTP_PASSWORD=
