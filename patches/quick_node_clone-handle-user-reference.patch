+  /**
+   * Handle user reference fields in a node.
+   *
+   * Ensures that user reference fields have their target_bundles set to null
+   * since the user entity type doesn't support bundles.
+   *
+   * @param \Drupal\node\Entity\Node $node
+   *   The node to process.
+   *
+   * @return \Drupal\node\Entity\Node
+   *   The node with properly configured user reference fields.
+   */
+  public function handleUserReferenceFields(Node $node) {
+    foreach ($node->getFieldDefinitions() as $field_definition) {
+      $field_storage_definition = $field_definition->getFieldStorageDefinition();
+      $field_settings = $field_storage_definition->getSettings();
+      $field_name = $field_storage_definition->getName();
+
+      // Check if this is an entity reference field that points to users.
+      if (isset($field_settings['target_type']) && $field_settings['target_type'] == 'user') {
+        if (!$node->get($field_name)->isEmpty()) {
+          // Get the field's handler settings.
+          $handler_settings = $field_definition->getSetting('handler_settings');
+
+          // If target_bundles is set, set it to null for user entity references.
+          if (isset($handler_settings['target_bundles'])) {
+            $handler_settings['target_bundles'] = null;
+
+            // Update the field's handler settings.
+            $field_definition->setSetting('handler_settings', $handler_settings);
+          }
+        }
+      }
+    }
+
+    return $node;
+  }
