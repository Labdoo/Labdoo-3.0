{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "ext-pdo": "*",
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/address": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/amazon_ses": "^3.1",
        "drupal/auto_entitylabel": "^3.0",
        "drupal/better_exposed_filters": "^6.0",
        "drupal/blazy": "^3.0",
        "drupal/book": "^2.0@alpha",
        "drupal/captcha": "^2.0",
        "drupal/charts": "^5.0",
        "drupal/charts_twig": "^1.0",
        "drupal/chosen": "^5.0",
        "drupal/computed_field": "^4.0@alpha",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_ignore": "^3.3",
        "drupal/core-composer-scaffold": "10.5.2",
        "drupal/core-project-message": "10.5.2",
        "drupal/core-recommended": "10.5.2",
        "drupal/core_views_facets": "^2.1",
        "drupal/country": "^2.1",
        "drupal/csv_serialization": "^4.0",
        "drupal/customerror": "^1.0@beta",
        "drupal/devel": "^5.1",
        "drupal/diff": "^1.9",
        "drupal/dropdown_language": "^4.0",
        "drupal/email_registration": "^2.0@RC",
        "drupal/entity": "^1.4",
        "drupal/eu_cookie_compliance": "^1.24",
        "drupal/facets_block": "^2.0",
        "drupal/field_group": "^4.0",
        "drupal/field_permissions": "^1.4",
        "drupal/flexible_permissions": "^2.0",
        "drupal/geocoder": "^4.23",
        "drupal/geofield": "^1.57",
        "drupal/geofield_map": "^11.0",
        "drupal/geolocation": "^4.0@beta",
        "drupal/gin": "^3.0@RC",
        "drupal/gin_toolbar": "^1.0@RC",
        "drupal/gin_toolbar_custom_menu": "^1.0",
        "drupal/google_analytics": "^4.0",
        "drupal/honeypot": "^2.1",
        "drupal/jquery_ui_autocomplete": "^2.1",
        "drupal/jquery_ui_menu": "^2.1",
        "drupal/key": "^1.19",
        "drupal/lang_dropdown": "^2.1",
        "drupal/legal": "^3.0",
        "drupal/linkchecker": "^2.1",
        "drupal/mailsystem": "^4.5",
        "drupal/markdown_easy": "^2.0",
        "drupal/masquerade": "^2.0@RC",
        "drupal/masquerade_float_block": "^2.0",
        "drupal/media_entity_slideshow": "^2.6",
        "drupal/media_library_edit": "^3.0",
        "drupal/owlcarousel": "^3.0",
        "drupal/paragraphs": "^1.19",
        "drupal/pathauto": "^1.12",
        "drupal/quick_node_clone": "^1.18",
        "drupal/recaptcha_v3": "^2.0",
        "drupal/redirect": "^1.12",
        "drupal/redis": "^1.7",
        "drupal/restui": "^1.22",
        "drupal/role_delegation": "^1.3",
        "drupal/search_api": "^1.31",
        "drupal/search_api_autocomplete": "^1.8",
        "drupal/token": "^1.13",
        "drupal/toolbar_menu": "^3.0",
        "drupal/ultimate_cron": "^2.0@alpha",
        "drupal/variationcache": "^1.5",
        "drupal/verf": "^2.0",
        "drupal/views_bulk_operations": "^4.3",
        "drupal/webform": "^6.3@beta",
        "drupal/workbench": "^1.6",
        "drush/drush": "^12.4",
        "firebase/php-jwt": "^6.10",
        "geocoder-php/free-geoip-provider": "^4.5",
        "geocoder-php/google-maps-provider": "^4.7",
        "league/commonmark": "^2.5",
        "predis/predis": "^2.2"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/amazon_ses": {
                "Fix Call to a member function get() on null and Undefined property $config": "patches/fix-amazon-ses-test-form-config-error.patch"
            },
            "drupal/core": {
                "Call to a member function getCacheTags() on null": "patches/core-getCacheTags-on-null.patch"
            },
            "drupal/markdown": {
                "Fixes a bug with CoreSubformState undeclared abstract methods": "patches/markdown-abstract-methods.patch"
            },
            "drupal/lang_dropdown": {
                "Issue #3500174": "patches/lang_dropdown-fix-error-get-library-name-3500174-2.patch"
            },
            "drupal/quick_node_clone": {
              "Fixes a bug when cloning user-reference fields": "patches/quick_node_clone-handle-user-reference.patch"
            },
            "drupal/gin": {
              "Fix chosen select height issue": "patches/gin-chosen-height-fix.patch"
            }
        }
    }
}
