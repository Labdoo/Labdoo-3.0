<div id="block-edoovillage-actions" class="block block-actions-block-block">
    <div class="views-exposed-form block-views">
        <div class="block-title-wrapper block-actions-toggle">
            <span class="block-title">{{ "Actions available for this edoovillage:"|t }}</span>
            <span class="toggle-icon"></span>
        </div>
        <div class="block-actions-content">
            <div class="actions">
            {% if data_link is not empty %}
            <div class="action tab"><a href="{{ data_link }}"><img class="icon" src="{{ labdoo_asset('themes/custom/labdoo_next/images/edoovillage-60.webp') }}" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/edoovillage-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/edoovillage-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/edoovillage-90.webp') }} 90w" sizes="19px" alt="" loading="lazy" decoding="async" width="752" height="704">{{ "EdooVillage details"|t }}</a></div>
            {% endif %}
            {% if dootronics_link is not empty %}
            <div class="action tab"><a href="{{ dootronics_link }}"><img class="icon" src="{{ labdoo_asset('themes/custom/labdoo_next/images/laptop-60.webp') }}" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/laptop-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/laptop-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/laptop-90.webp') }} 90w" sizes="19px" alt="" loading="lazy" decoding="async" width="367" height="360">{{ "Related dootronics"|t }}</a></div>
            {% endif %}
            {% if dootrips_link is not empty %}
            <div class="action tab"><a href="{{ dootrips_link }}"><img class="icon" src="{{ labdoo_asset('themes/custom/labdoo_next/images/dootrip-60.webp') }}" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/dootrip-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/dootrip-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/dootrip-90.webp') }} 90w" sizes="19px" alt="" loading="lazy" decoding="async" width="354" height="231">{{ "Related dootrips"|t }}</a></div>
            {% endif %}
            {% if edit_link is not empty %}
            <div class="action"><a href="{{ edit_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/house-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/house-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/house-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/house.png" alt="" loading="lazy" decoding="async" width="154" height="116"></picture>{{ "Edit this edoovillage"|t }}</a></div>
            {% endif %}
            {% if photo_album_link is not empty %}
            <div class="action"><a href="{{ photo_album_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/photo-album-icon-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/photo-album-icon-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/photo-album-icon-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/photo-album-icon.png" alt="" loading="lazy" decoding="async" width="800" height="800"></picture>{{ "Go to photo album"|t }}</a></div>
            {% endif %}
            {% if write_story_link is not empty %}
            <div class="action"><a href="{{ write_story_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/pencil-icon-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/pencil-icon-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/pencil-icon-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/pencil-icon.png" alt="" loading="lazy" decoding="async" width="800" height="800"></picture>{{ "Write a story about this edoovillage"|t }}</a></div>
            {% endif %}
            {% if story_link is not empty %}
            <div class="action"><a href="{{ story_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/pencil-icon-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/pencil-icon-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/pencil-icon-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/pencil-icon.png" alt="" loading="lazy" decoding="async" width="800" height="800"></picture>{{ "Read the story about this edoovillage"|t }}</a></div>
            {% endif %}
            {% if revisions_link is not empty %}
            <div class="action"><a href="{{ revisions_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/revisions-icon-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/revisions-icon-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/revisions-icon-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/revisions-icon.png" alt="" loading="lazy" decoding="async" width="369" height="310"></picture>{{ "Review changes"|t }}</a></div>
            {% endif %}
            {% if clone_link is not empty %}
            <div class="action">{% if clone_link is not empty %}<a href="{{ clone_link }}">{% endif %}<picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/clone-icon-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/clone-icon-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/clone-icon-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/clone-icon.png" alt="" loading="lazy" decoding="async" width="449" height="381"></picture>{{ "Clone this edoovillage"|t }}{% if clone_link is not empty %}</a>{% endif %}</div>
            {% endif %}
            {% if next_link is not empty %}
            <div class="action"><a href="{{ next_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/arrow-right-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/arrow-right-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/arrow-right-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/arrow-right.png" alt="" loading="lazy" decoding="async" width="94" height="114"></picture>{{ "Next edoovillage"|t }}</a></div>
            {% endif %}
            {% if previous_link is not empty %}
            <div class="action"><a href="{{ previous_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/arrow-left-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/arrow-left-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/arrow-left-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/arrow-left.png" alt="" loading="lazy" decoding="async" width="94" height="114"></picture>{{ "Previous edoovillage"|t }}</a></div>
            {% endif %}
        </div>
        <div class="block-title-wrapper"><span class="block-title">{{ "The edoovillage's semaphore:"|t }}</span> <a href="/content/managing-your-edoovillage-semaphore">{{ "Help"|t }}</a></div>
        {% set semaphore_size = {'green': [431, 864], 'yellow': [422, 855], 'red': [420, 891]}[semaphore]|default(null) %}
        <picture class="ldn-action-icon">{% if semaphore_size %}<source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/semaphore-' ~ semaphore ~ '-en-120.webp') }} 120w, {{ labdoo_asset('themes/custom/labdoo_next/images/semaphore-' ~ semaphore ~ '-en-240.webp') }} 240w, {{ labdoo_asset('themes/custom/labdoo_next/images/semaphore-' ~ semaphore ~ '-en-360.webp') }} 360w" sizes="120px">{% endif %}
        <img class="semaphore" src='/themes/custom/labdoo/img/semaphore-{{ semaphore }}-en.png' alt="{{ 'Project semaphore: @state'|t({'@state': semaphore|t}) }}" loading="lazy" decoding="async"{% if semaphore_size %} width="{{ semaphore_size[0] }}" height="{{ semaphore_size[1] }}"{% endif %}></picture>
        <div class="block-title-wrapper"><span class="block-title">{{ "Project status:"|t }}</span> <span class="edoovillage-status-{{ status }}">{{ status|t }}</span></div>
        </div>
    </div>
</div>
