<div id="block-dootrip-actions" class="block block-actions-block-block">
    <div class="views-exposed-form block-views">
        <div class="block-title-wrapper block-actions-toggle">
            <span class="block-title">{{ "Actions available for this dootrip:"|t }}</span>
            <span class="toggle-icon"></span>
        </div>
        <div class="block-actions-content">
            <div class="actions">
            {% if edit_link is not empty %}
            <div class="action"><a href="{{ edit_link }}"><img class="icon" src="{{ labdoo_asset('themes/custom/labdoo_next/images/dootrip-60.webp') }}" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/dootrip-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/dootrip-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/dootrip-90.webp') }} 90w" sizes="19px" alt="" loading="lazy" decoding="async" width="354" height="231">{{ "Edit this dootrip"|t }}</a></div>
            {% endif %}
            {% if revisions_link is not empty %}
            <div class="action"><a href="{{ revisions_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/revisions-icon-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/revisions-icon-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/revisions-icon-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/revisions-icon.png" alt="" loading="lazy" decoding="async" width="369" height="310"></picture>{{ "Review changes"|t }}</a></div>
            {% endif %}
            {% if clone_link is not empty %}
            <div class="action">{% if clone_link is not empty %}<a href="{{ clone_link }}">{% endif %}<picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/clone-icon-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/clone-icon-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/clone-icon-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/clone-icon.png" alt="" loading="lazy" decoding="async" width="449" height="381"></picture>{{ "Clone this dootrip"|t }}{% if clone_link is not empty %}</a>{% endif %}</div>
            {% endif %}
            {% if next_link is not empty %}
            <div class="action"><a href="{{ next_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/arrow-right-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/arrow-right-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/arrow-right-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/arrow-right.png" alt="" loading="lazy" decoding="async" width="94" height="114"></picture>{{ "Next dootrip"|t }}</a></div>
            {% endif %}
            {% if previous_link is not empty %}
            <div class="action"><a href="{{ previous_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/arrow-left-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/arrow-left-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/arrow-left-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/arrow-left.png" alt="" loading="lazy" decoding="async" width="94" height="114"></picture>{{ "Previous dootrip"|t }}</a></div>
            {% endif %}
        </div>
        <div class="block-title-wrapper"><span class="block-title">{{ "Dootrip status:"|t }}</span> <span class="dootrip-status-{{ status }}">{{ status|t }}</span></div>
        </div>
    </div>
</div>
