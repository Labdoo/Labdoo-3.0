<div id="block-team-actions" class="block block-actions-block-block">
    <div class="views-exposed-form block-views">
        <div class="block-title-wrapper block-actions-toggle">
            <span class="block-title">{{ 'Team'|t }} {{ team_name }}</span>
            <span class="toggle-icon"></span>
        </div>
        <div class="block-actions-content">
            <div class="actions">
            {% if about_link is not empty %}
                <div class="action"><a href="{{ about_link }}"><img class="icon" src="/themes/custom/labdoo/img/home.png" alt="" loading="lazy" decoding="async" width="283" height="289">{{ "About this team"|t }}</a></div>
            {% endif %}
            <div class="action"><a href="/teams"><img class="icon" src="/themes/custom/labdoo/img/all-teams.png" alt="" loading="lazy" decoding="async" width="289" height="288">{{ "All teams"|t }}</a></div>
            <div class="action"><a href="{{ wall_link }}"><img class="icon" src="/themes/custom/labdoo/img/wall.png" alt="" loading="lazy" decoding="async" width="274" height="300">{{ "View wall"|t }}</a></div>
            {% if edit_link is not empty %}
                <div class="action"><a href="{{ edit_link }}"><img class="icon" src="/themes/custom/labdoo/img/house.png" alt="" loading="lazy" decoding="async" width="154" height="116">{{ "Edit this team"|t }}</a></div>
            {% endif %}
            {% if post_link is not empty %}
                <div class="action"><a href="{{ tasks_link }}"><img class="icon" src="/themes/custom/labdoo/img/check.png" alt="" loading="lazy" decoding="async" width="300" height="300">{{ "View tasks"|t }}</a></div>
                <div class="action"><a href="{{ post_link }}"><img class="icon" src="/themes/custom/labdoo/img/conversation.png" alt="" loading="lazy" decoding="async" width="272" height="222">{{ "Start conversation"|t }}</a></div>
                <div class="action"><a href="{{ members_link }}"><img class="icon" src="/themes/custom/labdoo/img/team-members.png" alt="" loading="lazy" decoding="async" width="286" height="300">{{ "Team members"|t }}</a></div>
            {% endif %}
            <div class="action"><a href="{{ membership_link }}"><img class="icon" src="/themes/custom/labdoo/img/feed.png" alt="" loading="lazy" decoding="async" width="16" height="16">{{ membership_label }}</a></div>
        </div>
        </div>
    </div>
</div>
