<div id="block-team-actions" class="block block-actions-block-block">
    <div class="views-exposed-form block-views">
        <div class="block-title-wrapper block-actions-toggle">
            <span class="block-title">{{ 'Team'|t }} {{ team_name }}</span>
            <span class="toggle-icon"></span>
        </div>
        <div class="block-actions-content">
            <div class="actions">
            {% if about_link is not empty %}
                <div class="action"><a href="{{ about_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/home-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/home-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/home-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/home.png" alt="" loading="lazy" decoding="async" width="283" height="289"></picture>{{ "About this team"|t }}</a></div>
            {% endif %}
            <div class="action"><a href="/teams"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/all-teams-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/all-teams-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/all-teams-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/all-teams.png" alt="" loading="lazy" decoding="async" width="289" height="288"></picture>{{ "All teams"|t }}</a></div>
            <div class="action"><a href="{{ wall_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/wall-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/wall-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/wall-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/wall.png" alt="" loading="lazy" decoding="async" width="274" height="300"></picture>{{ "View wall"|t }}</a></div>
            {% if edit_link is not empty %}
                <div class="action"><a href="{{ edit_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/house-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/house-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/house-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/house.png" alt="" loading="lazy" decoding="async" width="154" height="116"></picture>{{ "Edit this team"|t }}</a></div>
            {% endif %}
            {% if post_link is not empty %}
                <div class="action"><a href="{{ tasks_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/check-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/check-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/check-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/check.png" alt="" loading="lazy" decoding="async" width="300" height="300"></picture>{{ "View tasks"|t }}</a></div>
                <div class="action"><a href="{{ post_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/conversation-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/conversation-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/conversation-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/conversation.png" alt="" loading="lazy" decoding="async" width="272" height="222"></picture>{{ "Start conversation"|t }}</a></div>
                <div class="action"><a href="{{ members_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/team-members-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/team-members-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/team-members-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/team-members.png" alt="" loading="lazy" decoding="async" width="286" height="300"></picture>{{ "Team members"|t }}</a></div>
            {% endif %}
            <div class="action"><a href="{{ membership_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="{{ labdoo_asset('themes/custom/labdoo_next/images/feed-30.webp') }} 30w, {{ labdoo_asset('themes/custom/labdoo_next/images/feed-60.webp') }} 60w, {{ labdoo_asset('themes/custom/labdoo_next/images/feed-90.webp') }} 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/feed.png" alt="" loading="lazy" decoding="async" width="16" height="16"></picture>{{ membership_label }}</a></div>
        </div>
        </div>
    </div>
</div>
