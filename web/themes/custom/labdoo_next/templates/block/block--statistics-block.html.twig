<div id="block-statistics" class="ldn-metrics block-statistics-block-block">
  {% set metrics = [
    {value: dootronics_tagged, label: 'Dootronics tagged'|t, url: dootronics_url},
    {value: dootronics_delivered, label: 'Delivered'|t, url: dootronics_url},
    {value: edoovillages, label: 'Schools'|t, url: edoovillages_url},
    {value: students, label: 'Students'|t, url: edoovillages_url},
    {value: hubs, label: 'Hubs'|t, url: hubs_url},
    {value: co2, label: 'Kg CO2 saved'|t, url: dootronics_url},
    {value: countries, label: 'Countries'|t, url: dootronics_url}
  ] %}
  {% for metric in metrics %}
    <a class="ldn-metric" href="{{ metric.url }}"><strong>{{ metric.value }}</strong><span>{{ metric.label }}</span></a>
  {% endfor %}
  <a class="ldn-metrics__more" href="{{ path('labdoo_statistics.advanced_statistics') }}">{{ 'View Advanced Metrics'|t }} <span aria-hidden="true">↗</span></a>
</div>
