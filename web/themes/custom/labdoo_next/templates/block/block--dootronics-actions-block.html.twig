<div id="block-dootronics-actions" class="block block-actions-block-block">
    <div class="views-exposed-form block-views">
        <div class="block-title-wrapper block-actions-toggle">
            <span class="block-title">{{ "Actions available for this dootronic:"|t }}</span>
            <span class="toggle-icon"></span>
        </div>
        <div class="block-actions-content">
            <div class="actions">
            {% if edit_link is not empty %}
            <div class="action"><a href="{{ edit_link }}"><img class="icon" src="/themes/custom/labdoo_next/images/laptop-60.webp" srcset="/themes/custom/labdoo_next/images/laptop-30.webp 30w, /themes/custom/labdoo_next/images/laptop-60.webp 60w, /themes/custom/labdoo_next/images/laptop-90.webp 90w" sizes="19px" alt="" loading="lazy" decoding="async" width="367" height="360">{{ "Edit this dootronic"|t }}</a></div>
            {% endif %}
            {% if revisions_link is not empty %}
            <div class="action"><a href="{{ revisions_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/revisions-icon-30.webp 30w, /themes/custom/labdoo_next/images/revisions-icon-60.webp 60w, /themes/custom/labdoo_next/images/revisions-icon-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/revisions-icon.png" alt="" loading="lazy" decoding="async" width="369" height="310"></picture>{{ "Review changes"|t }}</a></div>
            {% endif %}
            {% if clone_link is not empty %}
            <div class="action">{% if clone_link is not empty %}<a href="{{ clone_link }}">{% endif %}<picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/clone-icon-30.webp 30w, /themes/custom/labdoo_next/images/clone-icon-60.webp 60w, /themes/custom/labdoo_next/images/clone-icon-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/clone-icon.png" alt="" loading="lazy" decoding="async" width="449" height="381"></picture>{{ "Clone this dootronic"|t }}{% if clone_link is not empty %}</a>{% endif %}</div>
            {% endif %}
            {% if print_labels_link is not empty %}
            <div class="action"><a href="{{ print_labels_link }}" target="_blank" rel="noopener noreferrer"><picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/tag-30.webp 30w, /themes/custom/labdoo_next/images/tag-60.webp 60w, /themes/custom/labdoo_next/images/tag-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/tag.png" alt="" loading="lazy" decoding="async" width="278" height="154"></picture>{{ "Print tags"|t }}</a></div>
            {% endif %}
            {% if follow_link is not empty %}
            <div class="action"><a href="{{ follow_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/signal-30.webp 30w, /themes/custom/labdoo_next/images/signal-60.webp 60w, /themes/custom/labdoo_next/images/signal-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/signal.png" alt="" loading="lazy" decoding="async" width="256" height="256"></picture>{{ "Follow this dootronic"|t }}</a></div>
            {% endif %}
            {% if unfollow_link is not empty %}
            <div class="action"><a href="{{ unfollow_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/signal-off-30.webp 30w, /themes/custom/labdoo_next/images/signal-off-60.webp 60w, /themes/custom/labdoo_next/images/signal-off-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/signal-off.png" alt="" loading="lazy" decoding="async" width="379" height="370"></picture>{{ "Unfollow this dootronic"|t }}</a></div>
            {% endif %}
            {% if pick_me_up_status == 1 %}
                <div class="action">{% if pick_me_up_link is not empty %}<a href="{{ pick_me_up_link }}">{% endif %}<picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/truck-30.webp 30w, /themes/custom/labdoo_next/images/truck-60.webp 60w, /themes/custom/labdoo_next/images/truck-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/truck.png" alt="" loading="lazy" decoding="async" width="47" height="42"></picture>{{ "Pick me up (activated)"|t }}{% if pick_me_up_link is not empty %}</a>{% endif %}</div>
            {% else %}
                <div class="action">{% if pick_me_up_link is not empty %}<a href="{{ pick_me_up_link }}">{% endif %}<picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/truck-off-30.webp 30w, /themes/custom/labdoo_next/images/truck-off-60.webp 60w, /themes/custom/labdoo_next/images/truck-off-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/truck-off.png" alt="" loading="lazy" decoding="async" width="69" height="58"></picture>{{ "Pick me up (deactivated)"|t }}{% if pick_me_up_link is not empty %}</a>{% endif %}</div>
            {% endif %}
            {% if next_link is not empty %}
            <div class="action"><a href="{{ next_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/arrow-right-30.webp 30w, /themes/custom/labdoo_next/images/arrow-right-60.webp 60w, /themes/custom/labdoo_next/images/arrow-right-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/arrow-right.png" alt="" loading="lazy" decoding="async" width="94" height="114"></picture>{{ "Next dootronic"|t }}</a></div>
            {% endif %}
            {% if previous_link is not empty %}
            <div class="action"><a href="{{ previous_link }}"><picture class="ldn-action-icon"><source type="image/webp" srcset="/themes/custom/labdoo_next/images/arrow-left-30.webp 30w, /themes/custom/labdoo_next/images/arrow-left-60.webp 60w, /themes/custom/labdoo_next/images/arrow-left-90.webp 90w" sizes="19px"><img class="icon" src="/themes/custom/labdoo/img/arrow-left.png" alt="" loading="lazy" decoding="async" width="94" height="114"></picture>{{ "Previous dootronic"|t }}</a></div>
            {% endif %}
        </div>
        </div>
    </div>
</div>
