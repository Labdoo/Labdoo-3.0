{#
/**
 * @file
 * Custom block template for the search results exposed filter.
 */
#}
<div{{ attributes.addClass('views-exposed-form', 'block', 'block-views', 'block-views-exposed-filter-blocksearch-results-page-1', 'search-overlay-block') }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {# Search icon that will be placed near the language switcher #}
  <div class="search-icon-wrapper">
    <a href="#" class="search-icon-trigger" aria-label="Open search">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </a>
  </div>

  {# The actual form in an overlay #}
  <div class="search-overlay">
    <div class="search-overlay-content">
      <a href="#" class="search-overlay-close" aria-label="Close search">&times;</a>
      {% block content %}
        {{ content }}
      {% endblock %}
    </div>
  </div>
</div>
