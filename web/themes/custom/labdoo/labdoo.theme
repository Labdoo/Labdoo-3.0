use Drupal\Core\Render\Element;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Asset\AttachedAssetsInterface;
use Drupal\Core\Render\Markup;
use Drupal\Component\Utility\Html;
use Drupal\user\UserInterface;

/**
 * Implements hook_preprocess_HOOK() for html.
 */
function labdoo_preprocess_html(&$variables) {
  $roles = \Drupal::currentUser()->getRoles();
  array_walk($roles, function (&$value, $index) {
    $value = sprintf('role-%s', $value);
  });
  if (in_array(\Drupal::routeMatch()->getRouteName(), [
    'labdoo_dootronics.print_labels',
    'labdoo_dootronics.print_selected_labels',
    'labdoo_dootronics.print_legacy_selected_labels',
  ], TRUE)) {
    $roles[] = 'dootronics-print-label-page';
  }
  $variables['roles'] = implode(' ', $roles);
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function labdoo_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if (in_array(\Drupal::routeMatch()->getRouteName(), [
    'labdoo_dootronics.print_labels',
    'labdoo_dootronics.print_selected_labels',
    'labdoo_dootronics.print_legacy_selected_labels',
  ], TRUE)) {
    $suggestions[] = 'page__dootronics_print_labels';
  }
}

/**
 * Implements hook_theme_suggestions_html_alter().
 */
function labdoo_theme_suggestions_html_alter(array &$suggestions, array $variables) {
  if (in_array(\Drupal::routeMatch()->getRouteName(), [
    'labdoo_dootronics.print_labels',
    'labdoo_dootronics.print_selected_labels',
    'labdoo_dootronics.print_legacy_selected_labels',
  ], TRUE)) {
    $suggestions[] = 'html__dootronics__print_labels';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page_attachments.
 */
function labdoo_page_attachments_alter(&$page) {
  $page['#attached']['library'][] = 'labdoo/labdoo_ui';
  labdoo_attach_search_metadata($page);

  if (in_array(\Drupal::routeMatch()->getRouteName(), [
    'labdoo_dootronics.print_labels',
    'labdoo_dootronics.print_selected_labels',
    'labdoo_dootronics.print_legacy_selected_labels',
  ], TRUE)) {
    $page['#attached']['library'][] = 'labdoo/print_labels';
  }
}

/**
 * Implements hook_preprocess_HOOK() for field.
 */
function labdoo_preprocess_field(&$variables) {
  if (($variables['element']['#field_name'] ?? '') !== 'user_picture') {
    return;
  }

  if (!empty($variables['items'])) {
    return;
  }

  $variables['items'][] = [
    'content' => labdoo_default_profile_picture_render_array(),
  ];
}

/**
 * Implements hook_preprocess_HOOK() for comment.
 */
function labdoo_preprocess_comment(&$variables) {
  if (labdoo_has_real_user_picture($variables['user_picture'] ?? NULL)) {
    return;
  }

  $variables['user_picture'] = labdoo_default_profile_picture_render_array();
}

/**
 * Determines whether a comment already has a real user picture to render.
 */
function labdoo_has_real_user_picture($userPicture): bool {
  if (empty($userPicture)) {
    return FALSE;
  }

  if (is_string($userPicture)) {
    return stripos($userPicture, '<img') !== FALSE;
  }

  if (!is_array($userPicture)) {
    return FALSE;
  }

  if (!empty($userPicture['#items'])) {
    return TRUE;
  }

  if (!empty($userPicture['#user'])
    && $userPicture['#user'] instanceof UserInterface
    && $userPicture['#user']->hasField('user_picture')) {
    return !$userPicture['#user']->get('user_picture')->isEmpty();
  }

  return FALSE;
}

/**
 * Returns render array for default profile picture.
 */
function labdoo_default_profile_picture_render_array(): array {
  $defaultImagePath = base_path() . \Drupal::service('extension.list.theme')->getPath('labdoo') . '/img/act-5-small.png';

  return [
    '#type' => 'html_tag',
    '#tag' => 'img',
    '#attributes' => [
      'src' => $defaultImagePath,
      'alt' => t('Default profile picture'),
      'loading' => 'lazy',
    ],
  ];
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function labdoo_preprocess_views_view_field(array &$variables): void {
  $output = (string) ($variables['output'] ?? '');
  if (!str_contains($output, '/themes/custom/labdoo/img/')) {
    return;
  }
  // Stored activity bodies predate accessible decorative icon markup. Fix the
  // rendered field rather than rewriting content or its revision history.
  $document = Html::load($output);
  foreach ($document->getElementsByTagName('img') as $image) {
    $src = $image->getAttribute('src');
    if (str_starts_with($src, '/themes/custom/labdoo/img/') && !$image->hasAttribute('alt')) {
      $image->setAttribute('alt', '');
      $image->setAttribute('loading', 'lazy');
      $image->setAttribute('decoding', 'async');
    }
  }
  $variables['output'] = Markup::create(Html::serialize($document));
}

/**
 * Implements hook_preprocess_pager().
 */
function labdoo_preprocess_pager(array &$variables): void {
  $variables['pagination_heading_level'] = 'h2';
}

/**
 * Implements hook_preprocess_views_mini_pager().
 */
function labdoo_preprocess_views_mini_pager(array &$variables): void {
  $variables['pagination_heading_level'] = 'h2';
}

/**
 * Implements hook_js_settings_alter().
 */
function labdoo_js_settings_alter(array &$settings, AttachedAssetsInterface $assets): void {
  // Avoid a late animated banner becoming the largest mobile paint.
  if (isset($settings['eu_cookie_compliance'])) {
    $settings['eu_cookie_compliance']['popup_delay'] = 0;
  }
  // Native selects retain keyboard access and avoid non-navigable Chosen links.
  foreach (array_keys($settings['lang_dropdown'] ?? []) as $key) {
    $settings['lang_dropdown'][$key]['widget'] = 'native';
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function labdoo_attach_search_metadata(array &$attachments): void {
  // Labdoo Next supplies its own metadata and consent-aware asset handling.
  if (\Drupal::theme()->getActiveTheme()->getName() !== 'labdoo') {
    return;
  }
  $attachments['#cache']['contexts'][] = 'languages:language_interface';
  $attachments['#cache']['tags'][] = 'config:system.site';
  $attachments['#attached']['html_head'][] = [
    ['#tag' => 'meta', '#attributes' => [
      'name' => 'description',
      'content' => (string) t('Labdoo connects volunteers worldwide to reuse technology and support education in schools and communities.'),
    ]],
    'labdoo_description',
  ];
}

/**
 * Implements hook_form_alter().
 */
function labdoo_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!\Drupal::currentUser()->isAnonymous()) {
    return;
  }
  labdoo_native_selects($form);
  foreach (array_keys($form['#attached']['drupalSettings']['lang_dropdown'] ?? []) as $key) {
    $form['#attached']['drupalSettings']['lang_dropdown'][$key]['widget'] = 'native';
  }
}

/**
 * Keeps public single selects keyboard-accessible without the Chosen wrapper.
 */
function labdoo_native_selects(array &$element): void {
  if (($element['#type'] ?? '') === 'select' && empty($element['#multiple'])) {
    $element['#chosen'] = FALSE;
    $element['#attributes']['class'][] = 'chosen-disable';
  }
  foreach (Element::children($element) as $key) {
    labdoo_native_selects($element[$key]);
  }
}
