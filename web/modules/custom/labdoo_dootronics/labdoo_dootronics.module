use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\labdoo_common\Event\InvalidateCacheTagsEvent;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function labdoo_dootronics_theme() {

  return [
    'dootronics_chart_block_block' => [
      'variables' => [
        'status_info' => NULL,
      ],
      'template' => 'block--dootronics-chart-block',
    ],
    'dootronics_actions_block_block' => [
      'variables' => [
        'edit_link' => '',
        'revisions_link' => '',
        'clone_link' => '',
        'print_labels_link' => '',
        'follow_link' => '',
        'unfollow_link' => '',
        'pick_me_up_status' => '',
        'pick_me_up_link' => '',
        'next_link' => '',
        'previous_link' => '',
      ],
      'template' => 'block--dootronics-actions-block',
    ],
    'dootronics_label' => [
      'variables' => [
        'dootronics_collection' => NULL,
      ],
      'template' => 'dootronics-label',
    ],
  ];
}


/**
 * Implements hook_form_alter().
 */
function labdoo_dootronics_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (
    $form_id === 'views_exposed_form' &&
    isset($form['#id'])
    && $form['#id'] === 'views-exposed-form-dootronics-dashboard-page-1'
  ) {
    /** @var \Drupal\labdoo_common\Service\Repository\CommonRepository $commonRepository */
    $commonRepository = \Drupal::service('labdoo_common.repository.common');
    $activeCountries = $commonRepository->getActiveCountries('dootronic');
    $allCountries = $form['field_country_value']['#options'];
    $selectedCountries = array_intersect_key(
      $allCountries,
      array_flip($activeCountries)
    );
    $selectedCountries = array_merge(
      ['All' => t('- Any -')],
      $selectedCountries
    );
    $form['field_country_value']['#options'] = $selectedCountries;
  }
}

/**
 * Implements hook_entity_presave().
 */
function labdoo_dootronics_entity_presave(EntityInterface $entity) {
  if ($entity->bundle() !== 'dootronic') {
    return;
  }

  // If this is a new dootronic node, set its title using the sequence manager
  if ($entity->isNew() && !isset($entity->original_entity_id)) {
    /** @var \Drupal\labdoo_dootronics\Service\SequenceManagerInterface $sequenceManager */
    $sequenceManager = \Drupal::service('labdoo_dootronics.sequence_manager');
    $sequenceId = $sequenceManager->get();
    /** @var \Drupal\labdoo_dootronics\Service\Repository\DootronicRepositoryInterface $dootronicRepository */
    $dootronicRepository = \Drupal::service('labdoo_dootronics.repository');
    $title = $dootronicRepository->updateId($sequenceId);
    $entity->set('title', $title);
    $entity->set('field_tagged', TRUE);
    // Release the lock.
    $sequenceManager->commit();
  }

  /** @var \Drupal\labdoo_dootronics\Service\Compute\DootronicComputeInterface $dootronicCompute */
  $dootronicCompute = \Drupal::service('labdoo_dootronics.compute');
  $dootronicCompute->setDootronicTitle($entity);
  $dootronicCompute->computeWattHours($entity);
}

/**
 * Implements hook_entity_insert().
 */
function labdoo_dootronics_entity_insert(EntityInterface $entity) {
  __labdoo_dootronics_recalculate($entity);

  if ($entity->bundle() === 'dootronic') {
    __labdoo_dootronics_enqueue_geocoding($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function labdoo_dootronics_entity_update(EntityInterface $entity) {
  __labdoo_dootronics_recalculate($entity);

  if ($entity->bundle() === 'dootronic') {
    __labdoo_dootronics_enqueue_geocoding($entity);
  }
}

/**
 * Implements hook_entity_delete().
 */
function labdoo_dootronics_entity_delete(EntityInterface $entity) {
  __labdoo_dootronics_recalculate($entity);
}

function __labdoo_dootronics_recalculate(EntityInterface $entity): void {
  if ($entity->bundle() !== 'dootronic' || !empty($entity->skip_recompute_enqueue)) {
    return;
  }

  /** @var \Drupal\labdoo_dootronics\Service\Compute\DootronicComputeInterface $dootronicCompute */
  $dootronicCompute = \Drupal::service('labdoo_dootronics.compute');
  $dootronicCompute->enqueueRecompute($entity);
}

/**
 * Enqueue geocoding task if needed.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity.
 */
function __labdoo_dootronics_enqueue_geocoding(EntityInterface $entity): void {
  if ($entity->bundle() !== 'dootronic' || !empty($entity->skip_geocoding_enqueue)) {
    return;
  }

  $countryCode = !$entity->get('field_country')->isEmpty() ? $entity->get('field_country')->value : '';

  // If country is missing and we have coordinates, enqueue.
  if (empty($countryCode)) {
    if ($entity->hasField('field_locations') && !$entity->get('field_locations')->isEmpty()) {
      $locationData = $entity->get('field_locations')->first()->getValue();
      if (isset($locationData['lat']) && isset($locationData['lon'])) {
        // Validation check for absurd coordinates.
        if (abs((float)$locationData['lat']) < 0.1 && abs((float)$locationData['lon']) < 0.1) {
          return;
        }

        /** @var \Drupal\Core\Queue\QueueFactory $queueFactory */
        $queueFactory = \Drupal::service('queue');
        $queue = $queueFactory->get('labdoo_dootronic_geocoding');
        $queue->createItem(['nid' => $entity->id()]);
      }
    }
  }
}

/**
 * Implements hook_views_query_alter().
 */
function labdoo_dootronics_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == 'dootronics_dashboard') {
    $user_id = \Drupal::request()->query->get('u');
    $mine = \Drupal::request()->query->get('mine');

    if (!empty($user_id) && is_numeric($user_id)) {
      $query->addWhere('AND', 'node_field_data.uid', $user_id, '=');
    }
    elseif (!empty($mine) && (int) $mine === 1) {
      $query->addWhere('AND', 'node_field_data.uid', \Drupal::currentUser()->id(), '=');
    }
  }
}
