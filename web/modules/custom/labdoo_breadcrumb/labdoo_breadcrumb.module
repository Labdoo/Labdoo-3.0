<?php

/**
 * @file
 * Labdoo Breadcrumb module.
 *
 * Provides a custom breadcrumb block for Labdoo that replaces Gin's breadcrumb.
 *
 * Developed by Natiboo <info@natiboo.es>
 *
 * @license https://www.gnu.org/licenses/agpl-3.0.en.html GNU AFFERO GENERAL PUBLIC LICENSE
 * @link http://natiboo.es
 */

/**
 * Implements hook_theme().
 */
function labdoo_breadcrumb_theme($existing, $type, $theme, $path) {
  return [
    'labdoo_breadcrumb' => [
      'variables' => [
        'items' => [],
      ],
      'template' => 'labdoo-breadcrumb',
    ],
  ];
}

/**
 * Implements hook_page_top().
 *
 * Hides the default Drupal/Gin breadcrumb on routes where we show our custom block.
 */
function labdoo_breadcrumb_page_top(array &$page_top) {
  $route_name = \Drupal::routeMatch()->getRouteName();

  // Hide default breadcrumb for wiki pages.
  if ($route_name === 'entity.mini_wiki_page.canonical') {
    if (isset($page_top['breadcrumb'])) {
      $page_top['breadcrumb']['#access'] = FALSE;
    }
  }

  // Hide default breadcrumb for specific node types.
  if ($route_name === 'entity.node.canonical') {
    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node instanceof \Drupal\node\NodeInterface) {
      $type = $node->getType();
      if (in_array($type, ['edoovillage', 'hub', 'dootronic', 'dootrip', 'team', 'team_post'])) {
        if (isset($page_top['breadcrumb'])) {
          $page_top['breadcrumb']['#access'] = FALSE;
        }
      }
    }
  }

  // Hide default breadcrumb for views.
  if (strpos($route_name, 'view.') === 0) {
    if (isset($page_top['breadcrumb'])) {
      $page_top['breadcrumb']['#access'] = FALSE;
    }
  }
}

/**
 * Implements hook_preprocess_breadcrumb().
 *
 * Hide Gin's breadcrumb in the region for routes we handle.
 */
function labdoo_breadcrumb_preprocess_breadcrumb(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();

  // Hide for wiki pages.
  if ($route_name === 'entity.mini_wiki_page.canonical') {
    $variables['breadcrumb'] = [];
  }

  // Hide for specific node types.
  if ($route_name === 'entity.node.canonical') {
    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node instanceof \Drupal\node\NodeInterface) {
      $type = $node->getType();
      if (in_array($type, ['edoovillage', 'hub', 'dootronic', 'dootrip', 'team', 'team_post'])) {
        $variables['breadcrumb'] = [];
      }
    }
  }

  // Hide for views.
  if (strpos($route_name, 'view.') === 0) {
    $variables['breadcrumb'] = [];
  }
}
