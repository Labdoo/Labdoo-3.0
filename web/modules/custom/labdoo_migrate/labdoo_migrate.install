<?php

/**
 * @file
 * Install, update and uninstall hooks for the Labdoo Migrate module.
 */

/**
 * Implements hook_schema().
 */
function labdoo_migrate_schema(): array {
  $schema['labdoo_migrate_tracking'] = [
    'description' => 'Tracks Drupal 7 to Drupal 10 migrated entities.',
    'fields' => [
      'entity_type' => [
        'description' => 'Destination entity type in Drupal 10.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'bundle' => [
        'description' => 'Destination bundle/content type in Drupal 10.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'source_id' => [
        'description' => 'Source Drupal 7 entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'destination_id' => [
        'description' => 'Destination Drupal 10 entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'last_migrated' => [
        'description' => 'Unix timestamp of the latest successful migration.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'duration_ms' => [
        'description' => 'Duration in milliseconds of the latest migration for the entity.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'integrity_status' => [
        'description' => 'Status of the integrity check (0: not checked, 1: ok, 2: mismatch).',
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'last_integrity_check' => [
        'description' => 'Unix timestamp of the latest integrity check.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['entity_type', 'bundle', 'source_id'],
    'indexes' => [
      'bundle_idx' => ['bundle'],
      'last_migrated_idx' => ['last_migrated'],
      'destination_id_idx' => ['destination_id'],
      'integrity_status_idx' => ['integrity_status'],
    ],
  ];

  return $schema;
}

/**
 * Add migration duration to tracking table.
 */
function labdoo_migrate_update_9001(): void {
  $database = \Drupal::getContainer()->get('database');
  $table = 'labdoo_migrate_tracking';
  if (!$database->schema()->fieldExists($table, 'duration_ms')) {
    $database->schema()->addField($table, 'duration_ms', [
      'description' => 'Duration in milliseconds of the latest migration for the entity.',
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
}

/**
 * Add integrity status fields to tracking table.
 */
function labdoo_migrate_update_9002(): void {
  $database = \Drupal::getContainer()->get('database');
  $schema = $database->schema();
  $table = 'labdoo_migrate_tracking';

  if (!$schema->fieldExists($table, 'integrity_status')) {
    $schema->addField($table, 'integrity_status', [
      'description' => 'Status of the integrity check (0: not checked, 1: ok, 2: mismatch).',
      'type' => 'int',
      'size' => 'tiny',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }

  if (!$schema->fieldExists($table, 'last_integrity_check')) {
    $schema->addField($table, 'last_integrity_check', [
      'description' => 'Unix timestamp of the latest integrity check.',
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }

  if (!$schema->indexExists($table, 'integrity_status_idx')) {
    $schema->addIndex($table, 'integrity_status_idx', ['integrity_status'], [
      'fields' => [
        'integrity_status' => [
          'description' => 'Status of the integrity check (0: not checked, 1: ok, 2: mismatch).',
          'type' => 'int',
          'size' => 'tiny',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
    ]);
  }
}
