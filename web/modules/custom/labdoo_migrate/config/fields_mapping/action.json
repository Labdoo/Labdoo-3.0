      }
    },
    {
      "source": {
        "fields": [
          {
            "table": "location",
            "key": "node.nid",
            "field": "coords",
            "expression": "CONCAT(location.latitude, ',', location.longitude)",
            "ignore_langcode": "true",
            "joins": [
              {
                "type": "INNER",
                "table": "location_instance",
                "condition": "location_instance.lid = location.lid"
              },
              {
                "type": "INNER",
                "table": "node",
                "condition": "node.nid = location_instance.nid"
              }
            ]
          }
        ]
      },
      "destination": {
        "field": "field_locations",
        "special_type": {
          "type": "geolocation"
        }
