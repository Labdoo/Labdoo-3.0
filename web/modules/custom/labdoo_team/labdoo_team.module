use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Render\Element;
use Drupal\comment\CommentInterface;
use Drupal\node\Entity\Node;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;

const TEAM_GLOBAL = 24;

/**
 * Implements hook_theme().
 */
function labdoo_team_theme() {
  return [
    'team_actions_block_block' => [
      'variables' => [
        'team_name' => '',
        'wall_link' => '',
        'edit_link' => '',
        'membership_link' => '',
        'membership_label' => '',
        'post_link' => '',
        'members_link' => '',
        'tasks_link' => '',
      ],
      'template' => 'block--team-actions-block',
    ],
  ];
}

/**
 * Implements hook_views_data_alter().
 */
function labdoo_team_views_data_alter(array &$data) {
  foreach (Drupal::entityTypeManager()->getDefinitions() as $entityType => $entityInfo) {
    $baseTable = $entityInfo->getBaseTable();

    if (!isset($data[$baseTable]['team_membership_field'])) {
      $data[$baseTable]['team_membership_field'] = [
        'title' => t('Team membership'),
        'field' => [
          'id' => 'team_membership_field',
          'title' => t('Team membership'),
          'field' => '',
        ],
      ];
    }

  }
}

/**
 * Implements hook_node_view().
 */
function labdoo_team_node_view(
  array &$build,
  EntityInterface $node,
  EntityViewDisplayInterface $display,
  $view_mode
) {
  if ($node instanceof NodeInterface && $view_mode === 'full') {
    $nodeType = $node->getType();
    $conversationTypes = ['team_post', 'event'];
    $taskTypes = ['team_task', 'task_team'];

    if (in_array($nodeType, array_merge($conversationTypes, $taskTypes), TRUE)) {
      /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
      $membershipManager = \Drupal::service('labdoo_team.membership.manager');
      $teamId = $membershipManager->getTeamIdFromNode($node);

      if (is_numeric($teamId) && $node->access('update')) {
        // Ensure these contextual messages are rebuilt on every reload.
        \Drupal::service('page_cache_kill_switch')->trigger();
        if (\Drupal::hasService('dynamic_page_cache_kill_switch')) {
          \Drupal::service('dynamic_page_cache_kill_switch')->trigger();
        }

        $currentPath = \Drupal::service('path.current')->getPath();
        $pathAlias = \Drupal::service('path_alias.manager')->getAliasByPath($currentPath);

        if ($membershipManager->checkUserMembership((int) $teamId)) {
          $iconPath = base_path() . 'themes/custom/labdoo/img/equation-2-alpha-small.png';
          $items = [];
          $items[] = '<li style="display:flex; align-items:flex-start; gap:8px; margin:0 0 6px 0;"><img src="' . $iconPath . '" width="60" style="flex:0 0 auto; margin-top:0;"> <span style="color: #c09853;">' . t('You are a member of this team.') . '</span></li>';

          if (!preg_match('/activities/', $pathAlias)) {
            if (in_array($nodeType, $conversationTypes, TRUE)) {
              $items[] = '<li style="display:flex; align-items:flex-start; gap:8px; margin:0;"><img src="' . $iconPath . '" width="60" style="flex:0 0 auto; margin-top:0;"> <span style="color: #c09853;">' . t("If you want to change the list of people who will receive emails from this conversation, click on the 'Edit' tab below and modify the configuration under the 'Sharing options' section.") . '</span></li>';
            }
            elseif (in_array($nodeType, $taskTypes, TRUE)) {
              $items[] = '<li style="display:flex; align-items:flex-start; gap:8px; margin:0;"><img src="' . $iconPath . '" width="60" style="flex:0 0 auto; margin-top:0;"> <span style="color: #c09853;">' . t("If you want to change the status of this task, click on the 'Edit' tab below") . '</span></li>';
            }
          }

          $message = '<div class="messages messages--status" style="border:1px solid #f0e0b6; border-radius:4px; background:#fcf8e3; color:#c3842e; padding:14px"><ul style="list-style:none; margin:0; padding:0;">' . implode('', $items) . '</ul></div>';
        }
        else {
          $message = '<div class="messages messages--status" style="border:1px solid #f0e0b6; border-radius:4px; background:#fcf8e3; color:#c3842e; padding:14px"><ul style="list-style:none; margin:0; padding:0;">You are not a member of this team. If you want to be part of this team, click on \'Subscribe to this team\'.</div>';
        }

        $build['team_membership_notice'] = [
          '#type' => 'markup',
          '#markup' => Markup::create($message),
          '#weight' => -100,
          '#cache' => [
            'contexts' => ['user', 'url.path'],
            'tags' => [
              sprintf('team:%d:%d', (int) $teamId, (int) \Drupal::currentUser()->id()),
              sprintf('node:%d', (int) $teamId),
            ],
          ],
        ];
      }
    }
  }

  if ($node->getType() === 'team' && $view_mode === 'full') {
    $teamId = $node->id();

    /** @var \Drupal\labdoo_team\Service\MembershipManager $teamMembershipManager */
    $teamMembershipManager = Drupal::service('labdoo_team.membership.manager');
    if (!$teamMembershipManager->checkUserMembership($teamId)) {
      $link = $teamMembershipManager->buildJoinLink(
        $teamId,
        ['class' => 'button']
      );
    }
    else {
      $link = $teamMembershipManager->buildLeaveLink(
        $teamId,
        ['class' => 'button']
      );
    }

    $build['membership_button'] = [
      '#type' => 'markup',
      '#markup' => $link->toString(),
      '#weight' => 100,
      '#cache' => [
        'contexts' => ['user', 'url.path'],
        'tags' => [
          sprintf('team:%d:%d', (int) $teamId, (int) \Drupal::currentUser()->id()),
          sprintf('node:%d', (int) $teamId),
        ],
      ],
    ];
  }
}

/**
 * Implements hook_node_presave().
 */
function labdoo_team_node_presave(NodeInterface $node) {
  if (
    $node->getType() === 'team_post'
    || $node->getType() === 'task_team'
  ) {
    $teamId = Drupal::request()->query->get('team_id');
    if (empty($teamId)) {
      return;
    }

    $team = Node::load($teamId);
    if (empty($team) || $team->bundle() !== 'team') {
      return;
    }

    $node->set('field_team', $teamId);
  }
}

/**
 * Implements hook_form_alter().
 */
function labdoo_team_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (
    $form_id === 'node_team_post_form'
    || $form_id === 'node_task_team_form'
  ) {
    /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
    $membershipManager = \Drupal::service('labdoo_team.membership.manager');
    $current_user = \Drupal::currentUser();
    if ($form_id === 'node_team_post_form' && !$current_user->hasRole('team_manager')) {
      if (isset($form['field_other_groups'])) {
        $form['field_other_groups']['#access'] = FALSE;
      }
    }

    $teamId = Drupal::request()->query->get('team_id');
    if (!$membershipManager->isAllowed((int) $teamId)) {
      $form['#access'] = FALSE;
      if ($form_state->isSubmitted()) {
        \Drupal::messenger()->addError(t('Only superhub managers can post in the Global Team.'));
      }
    }
  }

  if ($form_id === 'comment_comment_form') {
    /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
    $membershipManager = \Drupal::service('labdoo_team.membership.manager');

    $node = \Drupal::routeMatch()->getParameter('node');
    if (empty($node)) {
      /** @var \Drupal\comment\CommentInterface $comment */
      $comment = $form_state->getFormObject()->getEntity();
      $node = $comment->getCommentedEntity();
    }

    if ($node instanceof NodeInterface) {
      $teamId = $membershipManager->getTeamIdFromNode($node);
      if (!$membershipManager->canCommentOnTeamPost($teamId)) {
        $form['#access'] = FALSE;
        if ($form_state->isSubmitted()) {
          \Drupal::messenger()->addError(t('You must be a member of this team to comment.'));
        }
      }
    }
  }
}

/**
 * Implements hook_entity_field_access().
 */
function labdoo_team_entity_field_access($operation, \Drupal\Core\Field\FieldDefinitionInterface $field_definition, AccountInterface $account, \Drupal\Core\Field\FieldItemListInterface $items = NULL) {
  if ($field_definition->getName() === 'field_team_comments') {
    $node = NULL;
    if ($items) {
      $node = $items->getEntity();
    }
    else {
      // Fallback for when items is not provided.
      $node = \Drupal::routeMatch()->getParameter('node');
    }

    if ($node instanceof NodeInterface) {
      /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
      $membershipManager = \Drupal::service('labdoo_team.membership.manager');
      $teamId = $membershipManager->getTeamIdFromNode($node);
      if (!$membershipManager->isAllowed($teamId, $account)) {
        return AccessResult::forbidden();
      }
    }
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_node_access().
 */
function labdoo_team_node_access(NodeInterface $node, $op, AccountInterface $account) {
  /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
  $membershipManager = \Drupal::service('labdoo_team.membership.manager');

  if ($op === 'create' && ($node->getType() === 'team_post' || $node->getType() === 'task_team')) {
    $teamId = Drupal::request()->query->get('team_id');
    if (!$membershipManager->isAllowed((int) $teamId, $account)) {
      return AccessResult::forbidden();
    }
  }

  if ($op === 'update' || $op === 'delete') {
    $teamId = $membershipManager->getTeamIdFromNode($node);
    if (!$membershipManager->isAllowed($teamId, $account)) {
      return AccessResult::forbidden();
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_comment_access().
 */
function labdoo_team_comment_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if ($operation === 'create') {
    /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
    $membershipManager = \Drupal::service('labdoo_team.membership.manager');

    $node = \Drupal::routeMatch()->getParameter('node');
    if (!$node instanceof NodeInterface) {
      $comment = \Drupal::routeMatch()->getParameter('comment');
      if ($comment instanceof CommentInterface) {
        $node = $comment->getCommentedEntity();
      }
    }

    if ($node instanceof NodeInterface) {
      $teamId = $membershipManager->getTeamIdFromNode($node);
      if (!$membershipManager->canCommentOnTeamPost($teamId, $account)) {
        return AccessResult::forbidden();
      }
    }
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_node_links_alter().
 */
function labdoo_team_node_links_alter(array &$links, NodeInterface $node, array &$context) {
  /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
  $membershipManager = \Drupal::service('labdoo_team.membership.manager');
  $teamId = $membershipManager->getTeamIdFromNode($node);
  if (!$membershipManager->canCommentOnTeamPost($teamId)) {
    // Standard comment link keys: comment__[field_name]
    foreach ($links as $key => $value) {
      if (strpos($key, 'comment__') === 0 && isset($links[$key]['#links']['comment-add'])) {
        unset($links[$key]['#links']['comment-add']);
      }
    }
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function labdoo_team_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  if ($entity instanceof NodeInterface) {
    /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
    $membershipManager = \Drupal::service('labdoo_team.membership.manager');
    $teamId = $membershipManager->getTeamIdFromNode($entity);
    if (!$membershipManager->canCommentOnTeamPost($teamId)) {
      if (isset($build['field_team_comments'])) {
        // The comment default formatter nests the create form under the field's
        // delta items (e.g. $build['field_team_comments'][0]['comment_form']).
        // comment_preprocess_field() copies that element straight into the
        // template variable ($variables['comment_form'] = $element[0]['comment_form'])
        // and field--comment.html.twig renders the "Add new comment" <h2>
        // heading whenever that variable is truthy. Setting #access = FALSE only
        // blanks the form output while leaving the array non-empty (truthy), so
        // the heading would remain. Replacing it with an empty array keeps the
        // key present (no "undefined key" warning in comment_preprocess_field)
        // while being falsy in Twig, so both the form and its heading disappear.
        foreach (Element::children($build['field_team_comments']) as $delta) {
          if (isset($build['field_team_comments'][$delta]['comment_form'])) {
            $build['field_team_comments'][$delta]['comment_form'] = [];
          }
        }
        // Handle the legacy direct path as well, just in case.
        if (isset($build['field_team_comments']['comment_form'])) {
          $build['field_team_comments']['comment_form'] = [];
        }
      }
    }
  }
}

/**
 * Implements hook_comment_links_alter().
 */
function labdoo_team_comment_links_alter(array &$links, CommentInterface $entity, array &$context) {
  /** @var \Drupal\labdoo_team\Service\MembershipManager $membershipManager */
  $membershipManager = \Drupal::service('labdoo_team.membership.manager');
  $node = $entity->getCommentedEntity();
  if ($node instanceof NodeInterface) {
    $teamId = $membershipManager->getTeamIdFromNode($node);
    if (!$membershipManager->canCommentOnTeamPost($teamId)) {
      if (isset($links['comment']['#links']['comment-reply'])) {
        unset($links['comment']['#links']['comment-reply']);
      }
      // Check if there are other comment link keys just in case.
      foreach ($links as $key => $value) {
        if (isset($links[$key]['#links']['comment-reply'])) {
          unset($links[$key]['#links']['comment-reply']);
        }
      }
    }
  }
}

/**
 * Implements hook_user_insert().
 */
function labdoo_team_user_insert(UserInterface $account) {
  try {
    // Load the Global team (nid 24)
    $team = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->load(TEAM_GLOBAL);
    if ($team) {
      // Add the user to the team members
      $team->get('field_team_members')->appendItem($account->id());
      $team->save();
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('labdoo_team')->error('Failed to add user @user to the Global team: @error', [
      '@user' => $account->getAccountName(),
      '@error' => $e->getMessage(),
    ]);
  }
}
