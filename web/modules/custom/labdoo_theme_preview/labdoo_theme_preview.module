<?php

/**
 * @file
 * Cache variation for the optional Labdoo Next preview.
 */

/**
 * Implements hook_page_attachments_alter().
 */
function labdoo_theme_preview_page_attachments_alter(array &$attachments): void {
  // The preview's return link preserves the complete query, including filters.
  // Contextual dynamic caching must therefore vary by all query arguments.
  $attachments['#cache']['contexts'][] = 'url.query_args';
}
