<?php

declare(strict_types=1);

use Drupal\labdoo_translations\Plugin\Menu\CatalogMenuLinkContent;
use Drupal\menu_link_content\Plugin\Menu\MenuLinkContent;

/**
 * Implements hook_menu_links_discovered_alter().
 */
function labdoo_translations_menu_links_discovered_alter(array &$links): void {
  foreach ($links as &$definition) {
    // Leave static links and specialized dynamic plugins to their own providers.
    if (is_string($definition['class'] ?? NULL) && ltrim($definition['class'], '\\') === MenuLinkContent::class) {
      $definition['class'] = CatalogMenuLinkContent::class;
    }
  }
  unset($definition);
}
