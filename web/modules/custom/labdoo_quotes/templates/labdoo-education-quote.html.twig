<figure{{ attributes.addClass('labdoo-quote') }} data-quote-id="{{ quote.id }}">
  <blockquote cite="{{ quote.source }}">
    <p>«<span class="labdoo-quote__text">{{ quote.text }}</span>»</p>
  </blockquote>
  <figcaption>— <a class="labdoo-quote__author" href="{{ quote.source }}" rel="external">{{ quote.author }}</a></figcaption>
</figure>
