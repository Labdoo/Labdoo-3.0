<div id="block-edoovillage-actions" class="block block-actions-block-block">
    <div class="views-exposed-form block-views">
        <div class="block-title-wrapper"><span class="block-title">{{ "Actions available for this edoovillage:"|t }}</span></div>
        <div class="actions">
            {% if data_link is not empty %}
            <div class="action tab"><a href="{{ data_link }}"><img class="icon" src="/themes/custom/labdoo/img/edoovillage.png" alt="EdooVillage details">{{ "EdooVillage details"|t }}</a></div>
            {% endif %}
            {% if dootronics_link is not empty %}
            <div class="action tab"><a href="{{ dootronics_link }}"><img class="icon" src="/themes/custom/labdoo/img/laptop.png" alt="Related dootronics">{{ "Related dootronics"|t }}</a></div>
            {% endif %}
            {% if dootrips_link is not empty %}
            <div class="action tab"><a href="{{ dootrips_link }}"><img class="icon" src="/themes/custom/labdoo/img/dootrip.png" alt="Related dootrips">{{ "Related dootrips"|t }}</a></div>
            {% endif %}
            {% if edit_link is not empty %}
            <div class="action"><a href="{{ edit_link }}"><img class="icon" src="/themes/custom/labdoo/img/house.png">{{ "Edit this edoovillage"|t }}</a></div>
            {% endif %}
            {% if photo_album_link is not empty %}
            <div class="action"><a href="{{ photo_album_link }}"><img class="icon" src="/themes/custom/labdoo/img/photo-album-icon.png">{{ "Go to photo album"|t }}</a></div>
            {% endif %}
            {% if write_story_link is not empty %}
            <div class="action"><a href="{{ write_story_link }}"><img class="icon" src="/themes/custom/labdoo/img/pencil-icon.png">{{ "Write a story about this edoovillage"|t }}</a></div>
            {% endif %}
            {% if story_link is not empty %}
            <div class="action"><a href="{{ story_link }}"><img class="icon" src="/themes/custom/labdoo/img/pencil-icon.png">{{ "Read the story about this edoovillage"|t }}</a></div>
            {% endif %}
            {% if revisions_link is not empty %}
            <div class="action"><a href="{{ revisions_link }}"><img class="icon" src="/themes/custom/labdoo/img/revisions-icon.png">{{ "Review changes"|t }}</a></div>
            {% endif %}
            {% if clone_link is not empty %}
            <div class="action">{% if clone_link is not empty %}<a href="{{ clone_link }}">{% endif %}<img class="icon" src="/themes/custom/labdoo/img/clone-icon.png">{{ "Clone this edoovillage"|t }}{% if clone_link is not empty %}</a>{% endif %}</div>
            {% endif %}
            {% if next_link is not empty %}
            <div class="action"><a href="{{ next_link }}"><img class="icon" src="/themes/custom/labdoo/img/arrow-right.png">{{ "Next edoovillage"|t }}</a></div>
            {% endif %}
            {% if previous_link is not empty %}
            <div class="action"><a href="{{ previous_link }}"><img class="icon" src="/themes/custom/labdoo/img/arrow-left.png">{{ "Previous edoovillage"|t }}</a></div>
            {% endif %}
        </div>
        <div class="block-title-wrapper"><span class="block-title">{{ "The edoovillage's semaphore:"|t }}</span> <a href="/content/managing-your-edoovillage-semaphore">{{ "Help"|t }}</a></div>
        <img class="semaphore" src='/themes/custom/labdoo/img/semaphore-{{ semaphore }}-en.png'>
        <div class="block-title-wrapper"><span class="block-title">{{ "Project status:"|t }}</span> <span class="edoovillage-status-{{ status }}">{{ status|t }}</span></div>
    </div>
</div>
