use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\labdoo_common\Event\InvalidateCacheTagsEvent;
use Drupal\node\NodeInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function labdoo_edoovillage_theme() {

  return [
    'edoovillage_chart_block_block' => [
      'variables' => [
        'needed' => NULL,
        'delivered' => NULL,
        'in_transit' => NULL,
        'remaining' => NULL,
      ],
      'template' => 'block--edoovillage-chart-block',
    ],
    'edoovillage_actions_block_block' => [
      'variables' => [
        'edit_link' => '',
        'photo_album_link' => '',
        'story_link' => '',
        'write_story_link' => '',
        'revisions_link' => '',
        'clone_link' => '',
        'next_link' => '',
        'previous_link' => '',
        'dootronics_link' => '',
        'dootrips_link' => '',
        'pick_me_up_status' => '',
        'pick_me_up_link' => '',
        'semaphore' => NULL,
        'status' => NULL,
      ],
      'template' => 'block--edoovillage-actions-block',
    ],
  ];
}

/**
 * Implements hook_form_alter().
 */
function labdoo_edoovillage_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (
    $form_id === 'views_exposed_form' &&
    isset($form['#id'])
    && $form['#id'] === 'views-exposed-form-edoovillages-block-1'
  ) {
    labdoo_common_set_active_countries($form, 'edoovillage');
  }
}

/**
 * Implements hook_entity_insert().
 */
function labdoo_edoovillage_entity_insert(EntityInterface $entity) {
  __labdoo_edoovillage_clear_cachetag($entity);

  if ($entity->bundle() === 'edoovillage') {
    labdoo_gallery_create_or_update($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function labdoo_edoovillage_entity_update(EntityInterface $entity) {
  __labdoo_edoovillage_clear_cachetag($entity);

  if ($entity->bundle() === 'edoovillage') {
    labdoo_gallery_create_or_update($entity);
  }
}

/**
 * Implements hook_preprocess_page_title().
 */
function labdoo_edoovillage_preprocess_page_title(&$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');

  // Check if we're on a node page and it's an edoovillage node
  if ($node instanceof NodeInterface && $node->bundle() === 'edoovillage') {
    // Get the node ID
    $nid = $node->id();

    // Get the country and city
    $country = '';
    if (!$node->get('field_country')->isEmpty()) {
      $country_code = $node->get('field_country')->value;
      // Get the country name from the country code
      $country_manager = \Drupal::service('country_manager');
      $countries = $country_manager->getList();
      $country = $countries[$country_code] ?? $country_code;
    }


    // Remove any potential "Edoovillage #NNN - " prefix from the title
    $nodeTitle = $node->getTitle();
    if (preg_match('/^Edoovillage #\d+ - /', $nodeTitle)) {
      $nodeTitle = preg_replace('/^Edoovillage #\d+ - /', '', $nodeTitle);
    }

    // Set the title in the format: "Edoovillage #{{nid}} - {{country}}: {{title}}"
    $title = sprintf('Edoovillage #%d - %s: %s', $nid, $country, $nodeTitle);
    $variables['title'] = $title;
  }
}

/**
 * Implements hook_entity_delete().
 */
function labdoo_edoovillage_entity_delete(EntityInterface $entity) {
  __labdoo_edoovillage_clear_cachetag($entity);
}

/**
 * Implements hook_views_query_alter().
 */
function labdoo_edoovillage_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == 'edoovillages_dashboard' || $view->id() == 'edoovillages') {
    $user_id = \Drupal::request()->query->get('u');
    $mine = \Drupal::request()->query->get('mine');

    if (!empty($user_id) && is_numeric($user_id)) {
      $query->addWhere('AND', 'node_field_data.uid', $user_id, '=');
    }
    elseif (!empty($mine) && (int) $mine === 1) {
      $query->addWhere('AND', 'node_field_data.uid', \Drupal::currentUser()->id(), '=');
    }
  }
}

/**
 * Invalidate the node type cache tag.
 *
 * @return void
 */
function __labdoo_edoovillage_clear_cachetag(EntityInterface $entity): void {
  $tags = [
    'edoovillages_chart',
    'edoovillage:' . $entity->id(),
  ];
  $event = new InvalidateCacheTagsEvent();
  $event->setCacheTags($tags);

  /** @var \Symfony\Component\EventDispatcher\EventDispatcherInterface $eventDispatcher */
  $eventDispatcher = \Drupal::service('event_dispatcher');
  $eventDispatcher->dispatch($event, InvalidateCacheTagsEvent::EVENT_NAME);
}
