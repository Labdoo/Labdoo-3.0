use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function labdoo_edoovillage_theme() {

  return [
    'edoovillage_chart_block_block' => [
      'variables' => [
        'needed' => NULL,
        'delivered' => NULL,
        'in_transit' => NULL,
        'remaining' => NULL,
      ],
      'template' => 'block--edoovillage-chart-block',
    ],
    'edoovillage_actions_block_block' => [
      'variables' => [
        'data_link' => '',
        'edit_link' => '',
        'photo_album_link' => '',
        'story_link' => '',
        'write_story_link' => '',
        'revisions_link' => '',
        'clone_link' => '',
        'next_link' => '',
        'previous_link' => '',
        'dootronics_link' => '',
        'dootrips_link' => '',
        'pick_me_up_status' => '',
        'pick_me_up_link' => '',
        'semaphore' => NULL,
        'status' => NULL,
      ],
      'template' => 'block--edoovillage-actions-block',
    ],
  ];
}

/**
 * Implements hook_form_alter().
 */
function labdoo_edoovillage_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (
    $form_id === 'views_exposed_form' &&
    isset($form['#id'])
    && $form['#id'] === 'views-exposed-form-edoovillages-block-1'
  ) {
    labdoo_common_set_active_countries($form, 'edoovillage');
  }
}

/**
 * Implements hook_entity_presave().
 */
function labdoo_edoovillage_entity_presave(EntityInterface $entity) {
  if ($entity->bundle() !== 'edoovillage') {
    return;
  }

  // If this is a new edoovillage node, its title will be set in EdooVillageCompute::setEdooVillageTitle
  // which is called below. We no longer need to assign the ID here to avoid duplication
  // and ensure consistency between new and existing nodes.

  /** @var \Drupal\labdoo_edoovillage\Service\Compute\EdooVillageComputeInterface $edoovillageCompute */
  $edoovillageCompute = \Drupal::service('labdoo_edoovillage.compute');
  $edoovillageCompute->setEdooVillageTitle($entity);
}

/**
 * Implements hook_entity_insert().
 */
function labdoo_edoovillage_entity_insert(EntityInterface $entity) {
  if ($entity->bundle() === 'edoovillage') {
    if (!empty($entity->skip_recompute_enqueue) && !empty($entity->skip_geocoding_enqueue)) {
      return;
    }
    /** @var \Drupal\labdoo_edoovillage\Service\Compute\EdooVillageComputeInterface $edoovillageCompute */
    $edoovillageCompute = \Drupal::service('labdoo_edoovillage.compute');
    $edoovillageCompute->enqueueRecompute($entity);

    if (!\Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
      /** @var \Drupal\labdoo_gallery\Service\Compute\GalleryComputeInterface $galleryCompute */
      $galleryCompute = \Drupal::service('labdoo_gallery.compute');
      $galleryCompute->enqueueGalleryCreateOrUpdate($entity);
    }

    __labdoo_edoovillage_enqueue_geocoding($entity);
    __labdoo_edoovillage_invalidate_neighbors($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function labdoo_edoovillage_entity_update(EntityInterface $entity) {
  if ($entity->bundle() === 'edoovillage') {
    if (!empty($entity->skip_recompute_enqueue) && !empty($entity->skip_geocoding_enqueue)) {
      return;
    }
    /** @var \Drupal\labdoo_edoovillage\Service\Compute\EdooVillageComputeInterface $edoovillageCompute */
    $edoovillageCompute = \Drupal::service('labdoo_edoovillage.compute');
    $edoovillageCompute->enqueueRecompute($entity);

    if (!\Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
      /** @var \Drupal\labdoo_gallery\Service\Compute\GalleryComputeInterface $galleryCompute */
      $galleryCompute = \Drupal::service('labdoo_gallery.compute');
      $galleryCompute->enqueueGalleryCreateOrUpdate($entity);
    }

    __labdoo_edoovillage_enqueue_geocoding($entity);
  }
}

/**
 * Implements hook_preprocess_page_title().
 */
function labdoo_edoovillage_preprocess_page_title(&$variables) {
  // We no longer need to override the title here as it's correctly persisted in the node.
}

/**
 * Implements hook_entity_delete().
 */
function labdoo_edoovillage_entity_delete(EntityInterface $entity) {
  if ($entity->bundle() === 'edoovillage') {
    /** @var \Drupal\labdoo_edoovillage\Service\Compute\EdooVillageComputeInterface $edoovillageCompute */
    $edoovillageCompute = \Drupal::service('labdoo_edoovillage.compute');
    $edoovillageCompute->enqueueRecompute($entity);
    __labdoo_edoovillage_invalidate_neighbors($entity);
  }
}

/**
 * Invalidate neighbors' cache via queue.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity.
 */
function __labdoo_edoovillage_invalidate_neighbors(EntityInterface $entity): void {
  /** @var \Drupal\labdoo_common\Service\Queue\Feeder\NeighborInvalidationQueueFeederInterface $feeder */
  $feeder = \Drupal::service('labdoo_common.queue.feeder.neighbor_invalidation');
  $feeder->feedQueue('edoovillage', (int) $entity->id());
}


/**
 * Implements hook_views_query_alter().
 */
function labdoo_edoovillage_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == 'edoovillages_dashboard' || $view->id() == 'edoovillages') {
    $query->addField('node_field_data', 'nid', 'nid', ['function' => 'groupby']);
    $query->addGroupBy('node_field_data.nid');

    $user_id = \Drupal::request()->query->get('u');
    $mine = \Drupal::request()->query->get('mine');

    if (!empty($user_id) && is_numeric($user_id)) {
      $query->addWhere('AND', 'node_field_data.uid', $user_id, '=');
    }
    elseif (!empty($mine) && (int) $mine === 1) {
      $query->addWhere('AND', 'node_field_data.uid', \Drupal::currentUser()->id(), '=');
    }
  }
}


/**
 * Enqueue geocoding task if needed.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity.
 */
function __labdoo_edoovillage_enqueue_geocoding(EntityInterface $entity): void {
  if ($entity->bundle() !== 'edoovillage' || !empty($entity->skip_geocoding_enqueue)) {
    return;
  }

  $countryCode = !$entity->get('field_country')->isEmpty() ? $entity->get('field_country')->value : '';
  $nodeCity = '';
  if ($entity->hasField('field_city') && !$entity->get('field_city')->isEmpty()) {
    $nodeCity = $entity->get('field_city')->value;
  }

  // If city or country are missing and we have coordinates, enqueue.
  if (empty($countryCode) || empty($nodeCity)) {
    if ($entity->hasField('field_location') && !$entity->get('field_location')->isEmpty()) {
      $locationData = $entity->get('field_location')->first()->getValue();
      if (isset($locationData['lat']) && isset($locationData['lon'])) {
        /** @var \Drupal\Core\Queue\QueueFactory $queueFactory */
        $queueFactory = \Drupal::service('queue');
        $queue = $queueFactory->get('labdoo_edoovillage_geocoding');
        $queue->createItem(['nid' => $entity->id()]);
      }
    }
  }
}
