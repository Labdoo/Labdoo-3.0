use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_toolbar_alter().
 */
function labdoo_admin_toolbar_toolbar_alter(&$items) {
  if (isset($items['gin_secondary_toolbar'])) {
    unset($items['gin_secondary_toolbar']);
  }
}

/**
 * Implements hook_help().
 */
function labdoo_admin_toolbar_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.labdoo_admin_toolbar':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Custom admin toolbar with horizontal layout and dropdown menus.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_theme().
 */
function labdoo_admin_toolbar_theme() {
  return [
    'labdoo_admin_toolbar_block' => [
      'variables' => [
        'menu_items' => [],
      ],
      'template' => 'block--labdoo-admin-toolbar',
    ],
  ];
}

/**
 * Implements hook_library_info_build().
 */
function labdoo_admin_toolbar_library_info_build() {
  $libraries = [];

  $libraries['labdoo_admin_toolbar'] = [
    'version' => '1.x',
    'css' => [
      'theme' => [
        'css/labdoo-admin-toolbar.css' => [],
      ],
    ],
    'js' => [
      'js/labdoo-admin-toolbar.js' => [],
    ],
    'dependencies' => [
      'core/drupal',
      'core/jquery',
      'core/once',
    ],
  ];

  return $libraries;
}

/**
 * Implements hook_preprocess_html().
 */
function labdoo_admin_toolbar_preprocess_html(&$variables) {
  // Check if the current user has access to the admin toolbar.
  $user = \Drupal::currentUser();
  if ($user->hasPermission('access administration pages')) {
    // Add a class to the body when the admin toolbar is visible.
    $variables['attributes']['class'][] = 'has-labdoo-admin-toolbar';
  }
}

/**
 * Implements hook_preprocess_page().
 */
function labdoo_admin_toolbar_preprocess_page(&$variables) {
  // Check if the current user has access to the admin toolbar.
  $user = \Drupal::currentUser();
  if ($user->hasPermission('access administration pages')) {
    // Get the block plugin.
    $block_manager = \Drupal::service('plugin.manager.block');
    $plugin_block = $block_manager->createInstance('labdoo_admin_toolbar_block', []);

    // Render the block.
    $render = $plugin_block->build();

    // Add the block to the page.
    if (!isset($variables['page']['labdoo_admin_toolbar'])) {
      $variables['page']['labdoo_admin_toolbar'] = [];
    }
    $variables['page']['labdoo_admin_toolbar']['labdoo_admin_toolbar_block'] = $render;

    // Attach the library.
    $variables['#attached']['library'][] = 'labdoo_admin_toolbar/labdoo_admin_toolbar';
  }
}
