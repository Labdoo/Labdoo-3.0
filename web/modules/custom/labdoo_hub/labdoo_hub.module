use Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException;
use Drupal\Component\Plugin\Exception\PluginNotFoundException;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function labdoo_hub_theme() {

  return [
    'hub_chart_block_block' => [
      'variables' => [
        'needed' => NULL,
        'delivered' => NULL,
        'in_transit' => NULL,
        'remaining' => NULL,
      ],
      'template' => 'block--hub-chart-block',
    ],
    'hub_actions_block_block' => [
      'variables' => [
        'data_link' => '',
        'edit_link' => '',
        'photo_album_link' => '',
        'story_link' => '',
        'write_story_link' => '',
        'revisions_link' => '',
        'clone_link' => '',
        'next_link' => '',
        'previous_link' => '',
        'semaphore' => NULL,
        'dropping' => '',
        'sanitation' => '',
        'dootronics_link' => '',
        'dootrips_link' => '',
      ],
      'template' => 'block--hub-actions-block',
    ],
  ];
}

/**
 * Implements hook_form_alter().
 */
function labdoo_hub_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (
    $form_id === 'views_exposed_form' &&
    isset($form['#id'])
    && $form['#id'] === 'views-exposed-form-hubs-dashboard-page-1'
  ) {
    labdoo_common_set_active_countries($form, 'hub');
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function labdoo_hub_preprocess_node(&$variables) {
  $entity = $variables['node'];
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'hub') {
    return;
  }

  $variables['branches'] = _labdoo_hub_get_branches_list($entity->id());
}

/**
 * Implements hook_entity_insert().
 */
function labdoo_hub_entity_insert(EntityInterface $entity) {
  if ($entity->bundle() === 'hub') {
    if (!empty($entity->skip_recompute_enqueue)) {
      /** @var \Drupal\labdoo_hub\Service\Compute\HubComputeInterface $hubCompute */
      $hubCompute = \Drupal::service('labdoo_hub.compute');
      if (empty($entity->skip_geocoding_enqueue)) {
        $hubCompute->enqueueGeocoding($entity);
      }
      __labdoo_hub_invalidate_neighbors($entity);
      return;
    }
    /** @var \Drupal\labdoo_hub\Service\Compute\HubComputeInterface $hubCompute */
    $hubCompute = \Drupal::service('labdoo_hub.compute');
    $hubCompute->enqueueRecompute($entity);
    $hubCompute->enqueueGeocoding($entity);

    if (!\Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
      /** @var \Drupal\labdoo_gallery\Service\Compute\GalleryComputeInterface $galleryCompute */
      $galleryCompute = \Drupal::service('labdoo_gallery.compute');
      $galleryCompute->enqueueGalleryCreateOrUpdate($entity);
    }
    __labdoo_hub_invalidate_neighbors($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function labdoo_hub_entity_update(EntityInterface $entity) {
  if ($entity->bundle() === 'hub') {
    if (!empty($entity->skip_recompute_enqueue)) {
      /** @var \Drupal\labdoo_hub\Service\Compute\HubComputeInterface $hubCompute */
      $hubCompute = \Drupal::service('labdoo_hub.compute');
      if (empty($entity->skip_geocoding_enqueue)) {
        $hubCompute->enqueueGeocoding($entity);
      }
      return;
    }
    /** @var \Drupal\labdoo_hub\Service\Compute\HubComputeInterface $hubCompute */
    $hubCompute = \Drupal::service('labdoo_hub.compute');
    $hubCompute->enqueueRecompute($entity);
    $hubCompute->enqueueGeocoding($entity);

    if (!\Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
      /** @var \Drupal\labdoo_gallery\Service\Compute\GalleryComputeInterface $galleryCompute */
      $galleryCompute = \Drupal::service('labdoo_gallery.compute');
      $galleryCompute->enqueueGalleryCreateOrUpdate($entity);
    }
  }
}

/**
 * Implements hook_entity_delete().
 */
function labdoo_hub_entity_delete(EntityInterface $entity) {
  if ($entity->bundle() === 'hub') {
    /** @var \Drupal\labdoo_hub\Service\Compute\HubComputeInterface $hubCompute */
    $hubCompute = \Drupal::service('labdoo_hub.compute');
    $hubCompute->enqueueRecompute($entity);
    __labdoo_hub_invalidate_neighbors($entity);
  }
}

/**
 * Invalidate neighbors' cache via queue.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity.
 */
function __labdoo_hub_invalidate_neighbors(EntityInterface $entity): void {
  /** @var \Drupal\labdoo_common\Service\Queue\Feeder\NeighborInvalidationQueueFeederInterface $feeder */
  $feeder = \Drupal::service('labdoo_common.queue.feeder.neighbor_invalidation');
  $feeder->feedQueue('hub', (int) $entity->id());
}

/**
 * Implements hook_page_attachments().
 */
function labdoo_hub_page_attachments(array &$attachments) {
  $entity = \Drupal::routeMatch()->getParameter('node');
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'hub') {
    return;
  }

  $branches = _labdoo_hub_get_branches_list($entity->id());
  $hubLocations = _labdoo_hub_get_hub_locations($entity);
  $allLocations = _labdoo_hub_get_branches_list_locations($branches);
  $allLocations = array_merge($allLocations, $hubLocations);
  $data = [
    'branches' => $branches,
    'locations' => $allLocations,
  ];
  $attachments['#attached']['drupalSettings']['labdoo_hub']['data'] = $data;
  $attachments['#attached']['library'][] = 'labdoo_hub/gmaps';
}

/**
 * Implements hook_views_query_alter().
 */
function labdoo_hub_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == 'hubs_dashboard') {
    $user_id = \Drupal::request()->query->get('u');
    $mine = \Drupal::request()->query->get('mine');

    if (!empty($user_id) && is_numeric($user_id)) {
      $query->addWhere('AND', 'node_field_data.uid', $user_id, '=');
    }
    elseif (!empty($mine) && (int) $mine === 1) {
      $query->addWhere('AND', 'node_field_data.uid', \Drupal::currentUser()->id(), '=');
    }
  }
}


/**
 * Retrieves the branches list of a given hub.
 *
 * @param mixed $hubId
 *   The hub ID.
 *
 * @param $levelsLeft
 *   The levels left to search.
 *   Default: 3.
 *
 * @return array
 *   The branches list.
 */
function _labdoo_hub_get_branches_list($hubId, int $levelsLeft = 3): array {
  if (!is_numeric($hubId)) {
    return [];
  }

  $hubId = (int) $hubId;
  --$levelsLeft;

  try {
    $result = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->loadByProperties([
        'field_parent_hub' => $hubId,
      ]);
  }
  catch (InvalidPluginDefinitionException | PluginNotFoundException $e) {
    \Drupal::logger('labdoo_hub')->error($e->getMessage());

    return [];
  }

  // Find also all hub branches from this hub recursively (for all sublevels).
  $branchList = [];
  foreach ($result as $item) {
    if ($levelsLeft) {
      $branchListSubLevels = _labdoo_hub_get_branches_list($item->id(), $levelsLeft);
      $branchList = array_merge($branchList, $branchListSubLevels);
    }
    $branchList[] = $item;
  }

  return $branchList;
}

/**
 * Retrieves the locations of all the branches of a hub.
 *
 * @param array $branchList
 *   The branches list.
 *
 * @return array
 *   An array with the branches enriched with their locations.
 */
function _labdoo_hub_get_branches_list_locations(array $branchList): array {
  $allLocations = [];

  foreach ($branchList as $hub) {
    $hubLocations = _labdoo_hub_get_hub_locations($hub);
    $allLocations = array_merge($allLocations, $hubLocations);
  }

  return $allLocations;
}

/**
 * Retrieves the locations of a hub.
 *
 * @param \Drupal\Core\Entity\EntityInterface $hub
 *   The hub entity.
 *
 * @return array
 *   An array with the hub locations.
 */
function _labdoo_hub_get_hub_locations(EntityInterface $hub): array {
  $hubLocations = $hub->get('field_locations')->getValue();
  $locations = [];

  foreach ($hubLocations as $hubLocation) {
    if (!isset($hubLocation['lat']) || !isset($hubLocation['lon'])) {
      continue;
    }

    $locations[] = [
      'title' => $hub->label(),
      'coords' => [
        'lat' => $hubLocation['lat'],
        'lng' => $hubLocation['lon'],
      ],
    ];
  }

  return $locations;
}
