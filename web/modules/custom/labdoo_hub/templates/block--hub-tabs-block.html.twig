<div id="block-hub-tabs" class="block block-actions-block-block">
    <div>
        <div class="tabs">
            {% if data_link is not empty %}
                {% if active_tab != 'data' %}
                    <div class="tab"><a href="{{ data_link }}"><img class="icon" src="/themes/custom/labdoo/img/back-to-hub.png" alt="Data"></a></div>
                {% endif %}
            {% endif %}
            {% if dootronics_link is not empty %}
                {% if active_tab == 'dootronics' %}
                    <div class="tab active"><img class="icon" src="/themes/custom/labdoo/img/dashboard-tabs-gics-en.png" alt="Dootronics"></div>
                {% else %}
                    <div class="tab"><a href="{{ dootronics_link }}"><img class="icon" src="/themes/custom/labdoo/img/dashboard-tabs-gics-en.png" alt="Dootronics"></a></div>
                {% endif %}
            {% endif %}
            {% if dootrips_link is not empty %}
                {% if active_tab == 'dootrips' %}
                    <div class="tab active"><img class="icon" src="/themes/custom/labdoo/img/dashboard-tabs-dootrips-en.png" alt="Dootrips"></div>
                {% else %}
                    <div class="tab"><a href="{{ dootrips_link }}"><img class="icon" src="/themes/custom/labdoo/img/dashboard-tabs-dootrips-en.png" alt="Dootrips"></a></div>
                {% endif %}
            {% endif %}
            {% if metrics_link is not empty %}
                {% if active_tab == 'metrics' %}
                    <div class="tab active"><img class="icon" src="/themes/custom/labdoo/img/dashboard-tabs-metrics-en.png" alt="Metrics"></div>
                {% else %}
                    <div class="tab"><a href="{{ metrics_link }}"><img class="icon" src="/themes/custom/labdoo/img/dashboard-tabs-metrics-en.png" alt="Metrics"></a></div>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
