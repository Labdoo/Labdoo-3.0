use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\comment\CommentInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function labdoo_notifications_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.labdoo_notifications':
      return '<p>' . t('Implements Labdoo communication features such as automatic email notifications.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function labdoo_notifications_theme() {
  return [
    'notification_email' => [
      'variables' => [
        'subject' => '',
        'body' => '',
      ],
      'template' => 'notification-email',
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function labdoo_notifications_mail($key, &$message, $email_params) {
  $message['subject'] = $email_params['subject'];
  $message['body'][] = $email_params['body'];
}

/**
 * Implements hook_node_presave().
 */
function labdoo_notifications_node_presave(EntityInterface $node) {
  if (!$node instanceof NodeInterface || \Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
    return;
  }

  // Process dootrip notifications.
  if ($node->getType() === 'dootrip') {
    /** @var Drupal\labdoo_notifications\Service\EntityProcessor\ $processor */
    $processor = \Drupal::service('labdoo_notifications.entity_processor.dootrip');
    $processor->process($node, 'presave', NULL);
  }
}

/**
 * Implements hook_node_insert().
 */
function labdoo_notifications_node_insert(EntityInterface $node) {
  if (!$node instanceof NodeInterface || \Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
    return;
  }

  // Process laptop notifications.
  if ($node->getType() === 'dootronic') {
    /** @var Drupal\labdoo_notifications\Service\EntityProcessor\LaptopProcessor $processor */
    $processor = \Drupal::service('labdoo_notifications.entity_processor.laptop');
    $processor->process($node, 'insert', NULL);
  }

  // Process dootrip notifications.
  if ($node->getType() === 'dootrip') {
    $processor = \Drupal::service('labdoo_notifications.entity_processor.dootrip');
    $processor->process($node, 'insert', NULL);

    // If "Announce this dootrip" is checked, also send an announcement email.
    if ($node->hasField('field_announce_this_dootrip') && (int) $node->get('field_announce_this_dootrip')->value === 1) {
      $processor->process($node, 'announce', NULL);
    }
  }

  // Process team-related notifications.
  if (in_array($node->getType(), ['event', 'team_task', 'team_post'])) {
    $processor = \Drupal::service("labdoo_notifications.entity_processor.{$node->getType()}");
    $processor->process($node, 'insert', NULL);
  }
}

/**
 * Implements hook_node_update().
 */
function labdoo_notifications_node_update(EntityInterface $node) {
  if (!$node instanceof NodeInterface || \Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
    return;
  }

  // Process laptop notifications.
  if ($node->getType() === 'dootronic') {
    /** @var Drupal\labdoo_notifications\Service\EntityProcessor\LaptopProcessor $processor */
    $processor = \Drupal::service('labdoo_notifications.entity_processor.laptop');
    $processor->process($node, 'update', NULL);
  }
}

/**
 * Implements hook_comment_insert().
 */
function labdoo_notifications_comment_insert(CommentInterface $comment) {
  $entity = $comment->getCommentedEntity();
  if (!$entity instanceof NodeInterface) {
    return;
  }

  // Process team-related notifications for comments.
  if (in_array($entity->getType(), ['event', 'team_task', 'team_post'])) {
    $processor = \Drupal::service("labdoo_notifications.entity_processor.{$entity->getType()}");
    $processor->process($entity, 'insert', $comment);
  }
}

/**
 * Implements hook_user_insert().
 */
function labdoo_notifications_user_insert(EntityInterface $account) {
  if (\Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
    return;
  }
  $processor = \Drupal::service('labdoo_notifications.entity_processor.user');
  $processor->process($account, 'insert', NULL);
}

/**
 * Implements hook_mail_alter().
 */
function labdoo_notifications_mail_alter(&$message) {
  // Disable the default user registration email.
  if ($message['id'] === 'user_register_no_approval_required') {
    $message['send'] = FALSE;
  }

  // Ensure there's a 'to' field.
  if (empty($message['to'])) {
    \Drupal::logger('labdoo_notifications')->warning('Trying to send a message without a \'to\' field');
    $message['send'] = FALSE;
  }

  // Redirect all outgoing emails to the test email address if test mode is enabled.
  $config = \Drupal::config('labdoo_notifications.settings');
  if ($config->get('test_mode') && !empty($config->get('test_email'))) {
    $test_email = $config->get('test_email');

    // Log the redirection of the email.
    \Drupal::logger('labdoo_notifications')->notice('Test mode is active. Redirecting email "@id" from "@original_to" to "@test_email".', [
      '@id' => $message['id'],
      '@original_to' => $message['to'],
      '@test_email' => $test_email,
    ]);

    // Check if the message is HTML.
    $is_html = FALSE;
    if (isset($message['headers']['Content-Type']) && strpos($message['headers']['Content-Type'], 'text/html') !== FALSE) {
      $is_html = TRUE;
    }
    elseif (isset($message['params']['html']) && $message['params']['html']) {
      $is_html = TRUE;
    }
    else {
      // Check if body content looks like HTML
      $body_str = is_array($message['body']) ? implode('', $message['body']) : (string) $message['body'];
      if (preg_match('/<[a-z][\s\S]*>/i', $body_str)) {
        $is_html = TRUE;
      }
    }

    // Prepend a test header/note to the message body if not already present.
    $original_to = $message['to'];
    $body_str = is_array($message['body']) ? implode('', $message['body']) : (string) $message['body'];

    if (strpos($body_str, '**TEST MODE ENABLED**') === FALSE) {
      if ($is_html) {
        $header_text = "<strong>**TEST MODE ENABLED**</strong><br />" .
                      "Original To: " . htmlspecialchars($original_to, ENT_QUOTES, 'UTF-8') . "<br />" .
                      "-----------------------------------<br /><br />";
      }
      else {
        $header_text = "**TEST MODE ENABLED**\n" .
                      "Original To: $original_to\n" .
                      "-----------------------------------\n\n";
      }

      if (is_array($message['body'])) {
        array_unshift($message['body'], $header_text);
      }
      else {
        $message['body'] = $header_text . $message['body'];
      }
    }

    // Set the recipient to the test email address.
    $message['to'] = $test_email;

    // Clear CC and BCC headers to prevent emails from going to real addresses.
    if (isset($message['headers']['Cc'])) {
      unset($message['headers']['Cc']);
    }
    if (isset($message['headers']['Bcc'])) {
      unset($message['headers']['Bcc']);
    }
  }

  // Dynamically replace the production host with the current site's real host.
  $host = '';
  try {
    if (\Drupal::hasRequest()) {
      $host = \Drupal::request()->getSchemeAndHttpHost();
    }
  }
  catch (\Exception $e) {
    // Ignore exceptions.
  }
  if (empty($host) || strpos($host, 'http') !== 0) {
    global $base_url;
    $host = $base_url;
  }
  if (empty($host) || strpos($host, 'http') !== 0) {
    $host = 'https://platform.labdoo.org';
  }

  if (!empty($host) && $host !== 'https://platform.labdoo.org') {
    if (!empty($message['subject'])) {
      $message['subject'] = str_replace('https://platform.labdoo.org', $host, $message['subject']);
    }
    if (!empty($message['body'])) {
      if (is_array($message['body'])) {
        foreach ($message['body'] as $key => $body_part) {
          if (is_string($body_part)) {
            $message['body'][$key] = str_replace('https://platform.labdoo.org', $host, $body_part);
          }
        }
      }
      elseif (is_string($message['body'])) {
        $message['body'] = str_replace('https://platform.labdoo.org', $host, $message['body']);
      }
    }
  }
}

/**
 * Implements hook_cron().
 */
function labdoo_notifications_cron() {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $now = new \DateTime();
  $today = $now->format('Y-m-d');

  // 1. First-time expiration notification.
  // Find dootrips that expired today or earlier and haven't been marked as expired.
  $query = $storage->getQuery()
    ->condition('type', 'dootrip')
    ->condition('field_arrival_date', $today, '<')
    ->condition('field_expired', 0)
    ->condition('field_status_dootrip', 'DS0') // Only Pending
    ->accessCheck(FALSE);
  $nids = $query->execute();

  $processor = \Drupal::service('labdoo_notifications.entity_processor.dootrip');

  if (!empty($nids)) {
    $dootrips = $storage->loadMultiple($nids);
    foreach ($dootrips as $dootrip) {
      $dootrip->set('field_expired', 1);
      $dootrip->save();
      $processor->process($dootrip, 'expired', NULL);
    }
  }

  // 2. Reminders at 5, 10, and 15 days after expiration.
  $intervals = [5, 10, 15];
  foreach ($intervals as $days) {
    $targetDate = clone $now;
    $targetDate->modify("- $days days");
    $dateString = $targetDate->format('Y-m-d');

    $query = $storage->getQuery()
      ->condition('type', 'dootrip')
      ->condition('field_arrival_date', $dateString)
      ->condition('field_status_dootrip', 'DS0')
      ->accessCheck(FALSE);
    $nids = $query->execute();

    if (!empty($nids)) {
      $dootrips = $storage->loadMultiple($nids);
      foreach ($dootrips as $dootrip) {
        $processor->process($dootrip, 'expired', NULL);
      }
    }
  }
}

/**
 * Implements hook_token_info().
 */
function labdoo_notifications_token_info() {
  $info = [];
  $info['types']['labdoo_notifications'] = [
    'name' => t('Labdoo Notifications'),
    'description' => t('Tokens for Labdoo notification templates.'),
  ];
  $info['tokens']['labdoo_notifications']['contact_subject'] = [
    'name' => t('Contact Form Submitted Subject'),
    'description' => t('Translated subject for contact form submission autoreply.'),
  ];
  $info['tokens']['labdoo_notifications']['contact_body'] = [
    'name' => t('Contact Form Submitted Body'),
    'description' => t('Translated body for contact form submission autoreply.'),
  ];
  $info['tokens']['labdoo_notifications']['contact_shub_subject'] = [
    'name' => t('Contact Form Submitted Shub Subject'),
    'description' => t('Translated subject for contact form submission admin/superhub notification.'),
  ];
  $info['tokens']['labdoo_notifications']['contact_shub_body'] = [
    'name' => t('Contact Form Submitted Shub Body'),
    'description' => t('Translated body for contact form submission admin/superhub notification.'),
  ];
  $info['tokens']['labdoo_notifications']['contact_shub_to_mail'] = [
    'name' => t('Contact Form Admin Destination Email'),
    'description' => t('Resolves to Labdoo-DACH@Labdoo.org for DACH region, otherwise contact@labdoo.org.'),
  ];
  return $info;
}

/**
 * Implements hook_tokens().
 */
function labdoo_notifications_tokens($type, $tokens, array $data = [], array $options = []) {
  $replacements = [];

  if ($type === 'labdoo_notifications') {
    /** @var \Drupal\webform\WebformSubmissionInterface $webform_submission */
    $webform_submission = $data['webform_submission'] ?? NULL;

    // Get current interface language
    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();

    /** @var \Drupal\labdoo_notifications\Service\EmailProcessor $email_processor */
    $email_processor = \Drupal::service('labdoo_notifications.email_processor');

    // Build the parameters map to replace custom placeholders in our flat .email templates
    $params = [
      'NAME' => '',
      'EMAIL' => '',
      'SUBJECT' => '',
      'MESSAGE' => '',
      'REASON' => '',
      'USERNAME' => '',
      'USEREMAIL' => '',
      'COUNTRY' => '',
      'CITY' => '',
      'CAMPAIGN' => '',
      'CONTACT_EMAIL' => \Drupal::configFactory()->get('system.site')->get('mail'),
    ];

    if ($webform_submission) {
      $values = $webform_submission->getData();
      
      $country_field = $values['country'] ?? '';
      $country_val = is_array($country_field) ? ($country_field['country'] ?? '') : $country_field;
      
      $reason_val = $values['the_reason_you_are_contacting_labdoo_org'] ?? $values['category'] ?? '';
      
      $params['NAME'] = $values['name'] ?? '';
      $params['EMAIL'] = $values['email_address'] ?? '';
      $params['SUBJECT'] = $values['subject'] ?? '';
      $params['MESSAGE'] = $values['message'] ?? '';
      $params['REASON'] = $reason_val;
      $params['USERNAME'] = $values['name'] ?? '';
      $params['USEREMAIL'] = $values['email_address'] ?? '';
      $params['COUNTRY'] = $country_val;

      // Extract city from country address field array or top-level element.
      $city_val = $values['city'] ?? '';
      if (empty($city_val) && is_array($country_field)) {
        $city_val = $country_field['city'] ?? '';
      }
      $params['CITY'] = $city_val;

      // Clean campaign parameter if it was not resolved in URL (leaves token string).
      $campaign_val = $values['campaign'] ?? '';
      if (strpos($campaign_val, '[') !== FALSE) {
        $campaign_val = '';
      }
      $params['CAMPAIGN'] = $campaign_val;

      // Get translated reason/category label
      $webform = $webform_submission->getWebform();
      if ($webform) {
        $element = $webform->getElement('the_reason_you_are_contacting_labdoo_org') ?? $webform->getElement('category');
        if ($element && isset($element['#options'])) {
          $options_list = $element['#options'];
          if (isset($options_list[$reason_val])) {
            $params['REASON'] = (string) $options_list[$reason_val];
          }
        }
      }
    }

    foreach ($tokens as $name => $original) {
      switch ($name) {
        case 'contact_shub_to_mail':
          // Resolve destination email based on country
          $to_email = 'contact@labdoo.org';
          if ($webform_submission) {
            $values = $webform_submission->getData();
            $country_field = $values['country'] ?? '';
            $country_val = is_array($country_field) ? ($country_field['country'] ?? '') : $country_field;
            
            // Normalize country value to uppercase ISO code or check if it contains DACH country names
            // Germany (DE/Deutschland/Germany), Austria (AT/Österreich/Austria), Switzerland (CH/Schweiz/Switzerland)
            $country_lower = mb_strtolower((string) $country_val);
            if (
              $country_lower === 'de' || 
              $country_lower === 'at' || 
              $country_lower === 'ch' || 
              strpos($country_lower, 'germany') !== FALSE || 
              strpos($country_lower, 'deutschland') !== FALSE || 
              strpos($country_lower, 'austria') !== FALSE || 
              strpos($country_lower, 'österreich') !== FALSE || 
              strpos($country_lower, 'switzerland') !== FALSE || 
              strpos($country_lower, 'schweiz') !== FALSE
            ) {
              $to_email = 'Labdoo-DACH@Labdoo.org';
            }
          }
          $replacements[$original] = $to_email;
          break;

        case 'contact_subject':
          $template = $email_processor->loadTemplate($langcode, 'contact_form_submitted_subject');
          if (empty($template)) {
            $template = $email_processor->loadTemplate('en', 'contact_form_submitted_subject');
          }
          if ($template) {
            $email_processor->processParameters($params, $template);
            $replacements[$original] = $template;
          }
          break;

        case 'contact_body':
          $template = $email_processor->loadTemplate($langcode, 'contact_form_submitted_body');
          if (empty($template)) {
            $template = $email_processor->loadTemplate('en', 'contact_form_submitted_body');
          }
          if ($template) {
            $values = $webform_submission ? $webform_submission->getData() : [];
            $has_copy = !empty($values['copy']);

            if (!$has_copy) {
              // Remove the entire "This is the message..." coletilla block if no copy is requested.
              $pattern = '/(?:Diese Nachricht haben wir von Ihnen erhalten:\s*This is the message that you sent us:|This is the message that you sent us:|Este es el mensaje que nos enviaste:|Ci-dessous, le message que vous nous avez envoyé:|Dit is het bericht die je naar ons hebt verstuurd:|以下是您發送給我們的信息：|[^\n]+)\s*\-\-\-+\s*"?\[MESSAGE\]"?\s*\-\-\-+/u';
              $template = preg_replace($pattern, '', $template);
            }
            else {
              // If copy is requested, replace "[MESSAGE]" with a nicely formatted localized full submission details block.
              $labels = [
                'en' => [
                  'name' => 'Name',
                  'email' => 'Email address',
                  'country' => 'Country',
                  'city' => 'City',
                  'reason' => 'Reason for contacting',
                  'campaign' => 'Campaign',
                  'subject' => 'Subject',
                  'message' => 'Message',
                ],
                'es' => [
                  'name' => 'Nombre',
                  'email' => 'Dirección de correo electrónico',
                  'country' => 'País',
                  'city' => 'Ciudad',
                  'reason' => 'Motivo del contacto',
                  'campaign' => 'Campaña',
                  'subject' => 'Asunto',
                  'message' => 'Mensaje',
                ],
                'de' => [
                  'name' => 'Name',
                  'email' => 'E-Mail-Adresse',
                  'country' => 'Land',
                  'city' => 'Stadt',
                  'reason' => 'Grund für die Kontaktaufnahme',
                  'campaign' => 'Kampagne',
                  'subject' => 'Betreff',
                  'message' => 'Nachricht',
                ],
                'fr' => [
                  'name' => 'Nom',
                  'email' => 'Adresse e-mail',
                  'country' => 'Pays',
                  'city' => 'Ville',
                  'reason' => 'Motif du contact',
                  'campaign' => 'Campagne',
                  'subject' => 'Sujet',
                  'message' => 'Message',
                ],
                'nl' => [
                  'name' => 'Naam',
                  'email' => 'E-mailadres',
                  'country' => 'Land',
                  'city' => 'Stad',
                  'reason' => 'Reden voor contact',
                  'campaign' => 'Campagne',
                  'subject' => 'Onderwerp',
                  'message' => 'Bericht',
                ],
                'zh-hant' => [
                  'name' => '姓名',
                  'email' => '電子郵件地址',
                  'country' => '國家',
                  'city' => '城市',
                  'reason' => '聯絡原因',
                  'campaign' => '活動',
                  'subject' => '主題',
                  'message' => '訊息',
                ],
              ];
              $lang = isset($labels[$langcode]) ? $langcode : 'en';
              $lbl = $labels[$lang];

              $full_details = "";
              $full_details .= "{$lbl['name']}: " . ($params['NAME'] ?? '') . "\n";
              $full_details .= "{$lbl['email']}: " . ($params['EMAIL'] ?? '') . "\n";
              $full_details .= "{$lbl['country']}: " . ($params['COUNTRY'] ?? '') . "\n";
              $full_details .= "{$lbl['city']}: " . ($params['CITY'] ?? '') . "\n";
              $full_details .= "{$lbl['reason']}: " . ($params['REASON'] ?? '') . "\n";
              if (!empty($params['CAMPAIGN'])) {
                $full_details .= "{$lbl['campaign']}: " . $params['CAMPAIGN'] . "\n";
              }
              $full_details .= "{$lbl['subject']}: " . ($params['SUBJECT'] ?? '') . "\n";
              $full_details .= "{$lbl['message']}:\n\"" . ($params['MESSAGE'] ?? '') . "\"";

              $template = str_replace('"[MESSAGE]"', $full_details, $template);
              $template = str_replace('[MESSAGE]', $full_details, $template);
            }

            $email_processor->processParameters($params, $template);
            $replacements[$original] = nl2br($template);
          }
          break;

        case 'contact_shub_subject':
          $template = $email_processor->loadTemplate($langcode, 'contact_form_submitted_shub_subject');
          if (empty($template)) {
            $template = $email_processor->loadTemplate('en', 'contact_form_submitted_shub_subject');
          }
          if ($template) {
            $email_processor->processParameters($params, $template);
            $replacements[$original] = $template;
          }
          break;

        case 'contact_shub_body':
          $template = $email_processor->loadTemplate($langcode, 'contact_form_submitted_shub_body');
          if (empty($template)) {
            $template = $email_processor->loadTemplate('en', 'contact_form_submitted_shub_body');
          }
          if ($template) {
            $email_processor->processParameters($params, $template);
            $replacements[$original] = nl2br($template);
          }
          break;
      }
    }
  }

  return $replacements;
}
