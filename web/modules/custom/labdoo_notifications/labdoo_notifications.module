use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\comment\CommentInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function labdoo_notifications_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.labdoo_notifications':
      return '<p>' . t('Implements Labdoo communication features such as automatic email notifications.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function labdoo_notifications_theme() {
  return [
    'notification_email' => [
      'variables' => [
        'subject' => '',
        'body' => '',
      ],
      'template' => 'notification-email',
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function labdoo_notifications_mail($key, &$message, $email_params) {
  $message['subject'] = $email_params['subject'];
  $message['body'][] = $email_params['body'];
}

/**
 * Implements hook_node_presave().
 */
function labdoo_notifications_node_presave(EntityInterface $node) {
  if (!$node instanceof NodeInterface || \Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
    return;
  }

  // Process laptop notifications.
  if ($node->getType() === 'laptop') {
    /** @var Drupal\labdoo_notifications\Service\EntityProcessor\ $processor */
    $processor = \Drupal::service('labdoo_notifications.entity_processor.laptop');
    $processor->process($node, 'presave', NULL);
  }

  // Process dootrip notifications.
  if ($node->getType() === 'dootrip') {
    /** @var Drupal\labdoo_notifications\Service\EntityProcessor\ $processor */
    $processor = \Drupal::service('labdoo_notifications.entity_processor.dootrip');
    $processor->process($node, 'presave', NULL);
  }
}

/**
 * Implements hook_node_insert().
 */
function labdoo_notifications_node_insert(EntityInterface $node) {
  if (!$node instanceof NodeInterface || \Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
    return;
  }

  // Process dootrip notifications.
  if ($node->getType() === 'dootrip') {
    $processor = \Drupal::service('labdoo_notifications.entity_processor.dootrip');
    $processor->process($node, 'insert', NULL);

    // If "Announce this dootrip" is checked, also send an announcement email.
    if ($node->hasField('field_announce_this_dootrip') && (int) $node->get('field_announce_this_dootrip')->value === 1) {
      $processor->process($node, 'announce', NULL);
    }
  }

  // Process team-related notifications.
  if (in_array($node->getType(), ['team_page', 'event', 'team_task'])) {
    $processor = \Drupal::service("labdoo_notifications.entity_processor.{$node->getType()}");
    $processor->process($node, 'insert', NULL);
  }
}

/**
 * Implements hook_comment_insert().
 */
function labdoo_notifications_comment_insert(CommentInterface $comment) {
  $entity = $comment->getCommentedEntity();
  if (!$entity instanceof NodeInterface) {
    return;
  }

  // Process team-related notifications for comments.
  if (in_array($entity->getType(), ['team_page', 'event', 'team_task'])) {
    $processor = \Drupal::service("labdoo_notifications.entity_processor.{$entity->getType()}");
    $processor->process($entity, 'insert', $comment);
  }
}

/**
 * Implements hook_user_insert().
 */
function labdoo_notifications_user_insert(EntityInterface $account) {
  if (\Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
    return;
  }
  $processor = \Drupal::service('labdoo_notifications.entity_processor.user');
  $processor->process($account, 'insert', NULL);
}

/**
 * Implements hook_mail_alter().
 */
function labdoo_notifications_mail_alter(&$message) {
  // Disable the default user registration email.
  if ($message['id'] === 'user_register_no_approval_required') {
    $message['send'] = FALSE;
  }

  // Ensure there's a 'to' field.
  if (empty($message['to'])) {
    \Drupal::logger('labdoo_notifications')->warning('Trying to send a message without a \'to\' field');
    $message['send'] = FALSE;
  }
}

/**
 * Implements hook_cron().
 */
function labdoo_notifications_cron() {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $now = new \DateTime();
  $today = $now->format('Y-m-d');

  // 1. First-time expiration notification.
  // Find dootrips that expired today or earlier and haven't been marked as expired.
  $query = $storage->getQuery()
    ->condition('type', 'dootrip')
    ->condition('field_arrival_date', $today, '<')
    ->condition('field_expired', 0)
    ->condition('field_status_dootrip', 'DS0') // Only Pending
    ->accessCheck(FALSE);
  $nids = $query->execute();

  $processor = \Drupal::service('labdoo_notifications.entity_processor.dootrip');

  if (!empty($nids)) {
    $dootrips = $storage->loadMultiple($nids);
    foreach ($dootrips as $dootrip) {
      $dootrip->set('field_expired', 1);
      $dootrip->save();
      $processor->process($dootrip, 'expired', NULL);
    }
  }

  // 2. Reminders at 5, 10, and 15 days after expiration.
  $intervals = [5, 10, 15];
  foreach ($intervals as $days) {
    $targetDate = clone $now;
    $targetDate->modify("- $days days");
    $dateString = $targetDate->format('Y-m-d');

    $query = $storage->getQuery()
      ->condition('type', 'dootrip')
      ->condition('field_arrival_date', $dateString)
      ->condition('field_status_dootrip', 'DS0')
      ->accessCheck(FALSE);
    $nids = $query->execute();

    if (!empty($nids)) {
      $dootrips = $storage->loadMultiple($nids);
      foreach ($dootrips as $dootrip) {
        $processor->process($dootrip, 'expired', NULL);
      }
    }
  }
}
