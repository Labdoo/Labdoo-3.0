use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function labdoo_dootrip_theme() {

  return [
    'dootrip_chart_block_block' => [
      'variables' => [
        'capacity' => NULL,
        'in_transit' => NULL,
        'transported' => NULL,
        'total' => NULL,
      ],
      'template' => 'block--dootrip-chart-block',
    ],
    'dootrip_actions_block_block' => [
      'variables' => [
        'edit_link' => '',
        'revisions_link' => '',
        'clone_link' => '',
        'next_link' => '',
        'previous_link' => '',
        'status' => '',
      ],
      'template' => 'block--dootrip-actions-block',
    ],
  ];
}

/**
 * Implements hook_form_alter().
 */
function labdoo_dootrip_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (
    $form_id === 'views_exposed_form' &&
    isset($form['#id'])
    && $form['#id'] === 'views-exposed-form-dootrips-block-1'
  ) {
    labdoo_common_set_active_countries($form, 'dootrip');
  }

  if (
    in_array($form_id, ['node_dootrip_form', 'node_dootrip_edit_form'], TRUE)
    && isset($form['#validate'])
  ) {
    if (
      $form_id === 'node_dootrip_form'
      && \Drupal::currentUser()->isAuthenticated()
      && !$form_state->isSubmitted()
      && empty($form_state->getUserInput()['field_dootripper_s'])
      && isset($form['field_dootripper_s']['widget'][0]['target_id'])
    ) {
      $currentUser = \Drupal::entityTypeManager()->getStorage('user')->load(\Drupal::currentUser()->id());
      if ($currentUser !== NULL) {
        $form['field_dootripper_s']['widget'][0]['target_id']['#default_value'] = $currentUser;
      }
    }

    $form['#validate'][] = 'labdoo_dootrip_validate_date_order';
  }
}

/**
 * Validates dootrip departure/arrival date order.
 */
function labdoo_dootrip_validate_date_order(array &$form, FormStateInterface $form_state): void {
  $userInput = $form_state->getUserInput();
  $departureRawValue = !empty($departureRawValue) ? $departureRawValue : ($userInput['field_departure_date'] ?? NULL);
  $arrivalRawValue = !empty($arrivalRawValue) ? $arrivalRawValue : ($userInput['field_arrival_date'] ?? NULL);
  $departureDate = labdoo_dootrip_parse_date_value($departureRawValue);
  $arrivalDate = labdoo_dootrip_parse_date_value($arrivalRawValue);

  if ($departureDate !== NULL && $arrivalDate !== NULL && $departureDate > $arrivalDate) {
    $form_state->setErrorByName('field_departure_date', t('Departure date cannot be later than arrival date.'));
  }
}

/**
 * Parses a datetime widget value into DateTimeImmutable.
 */
function labdoo_dootrip_parse_date_value($fieldValue): ?\DateTimeImmutable {
  if (!is_array($fieldValue) || empty($fieldValue[0]['value'])) {
    return NULL;
  }

  $value = $fieldValue[0]['value'];

  if ($value instanceof \DateTimeInterface) {
    try {
      return new \DateTimeImmutable($value->format('Y-m-d H:i:s'), $value->getTimezone());
    }
    catch (\Exception $e) {
      return NULL;
    }
  }

  if (is_string($value) && $value !== '') {
    try {
      return new \DateTimeImmutable($value);
    }
    catch (\Exception $e) {
      return NULL;
    }
  }

  if (!is_array($value)) {
    return NULL;
  }

  $date = trim((string) ($value['date'] ?? ''));
  if ($date === '') {
    return NULL;
  }

  $time = trim((string) ($value['time'] ?? '00:00:00'));

  $dateTime = \DateTimeImmutable::createFromFormat('Y-m-d H:i:s', $date . ' ' . $time);
  if ($dateTime instanceof \DateTimeImmutable) {
    return $dateTime;
  }

  $dateTime = \DateTimeImmutable::createFromFormat('Y-m-d H:i', $date . ' ' . $time);
  if ($dateTime instanceof \DateTimeImmutable) {
    return $dateTime;
  }

  return NULL;
}

/**
 * Implements hook_entity_insert().
 */
function labdoo_dootrip_entity_insert(EntityInterface $entity) {
  if ($entity->bundle() === 'dootrip') {
    if (
      !empty($entity->skip_geocoding_enqueue) ||
      !empty($entity->skip_recompute_enqueue) ||
      \Drupal::state()->get('labdoo_migrate_is_running', FALSE)
    ) {
      return;
    }
    /** @var \Drupal\labdoo_dootrip\Service\Compute\DootripComputeInterface $dootripCompute */
    $dootripCompute = \Drupal::service('labdoo_dootrip.compute');
    $dootripCompute->enqueueCapacityRecompute($entity);
    $dootripCompute->enqueueGeocoding($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function labdoo_dootrip_entity_update(EntityInterface $entity) {
  if ($entity->bundle() === 'dootrip') {
    if (
      !empty($entity->skip_geocoding_enqueue) ||
      !empty($entity->skip_recompute_enqueue) ||
      \Drupal::state()->get('labdoo_migrate_is_running', FALSE)
    ) {
      return;
    }
    /** @var \Drupal\labdoo_dootrip\Service\Compute\DootripComputeInterface $dootripCompute */
    $dootripCompute = \Drupal::service('labdoo_dootrip.compute');

    if (labdoo_dootrip_has_any_field_changed($entity, [
      'field_laptops',
      'field_arrival_date',
      'field_dootrip_capacity',
      'field_dootronics_delivered',
      'field_dootronics_in_transit',
      'field_full',
    ])) {
      $dootripCompute->enqueueCapacityRecompute($entity);
    }

    if (labdoo_dootrip_has_any_field_changed($entity, [
      'field_origin_of_the_trip',
      'field_destination_of_the_trip',
    ])) {
      $dootripCompute->enqueueGeocoding($entity);
    }
  }
}

/**
 * Checks whether any listed field differs from the entity's original values.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity being saved.
 * @param string[] $field_names
 *   The field names to compare.
 *
 * @return bool
 *   TRUE if any listed field changed.
 */
function labdoo_dootrip_has_any_field_changed(
  EntityInterface $entity,
  array $field_names
): bool {
  if (
    !isset($entity->original) ||
    !($entity->original instanceof EntityInterface)
  ) {
    return TRUE;
  }

  foreach ($field_names as $field_name) {
    if (!$entity->hasField($field_name) || !$entity->original->hasField($field_name)) {
      continue;
    }

    if ($entity->get($field_name)->getValue() !== $entity->original->get($field_name)->getValue()) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_entity_delete().
 */
function labdoo_dootrip_entity_delete(EntityInterface $entity) {
  if ($entity->bundle() === 'dootrip') {
    /** @var \Drupal\labdoo_dootrip\Service\Compute\DootripComputeInterface $dootripCompute */
    $dootripCompute = \Drupal::service('labdoo_dootrip.compute');
    $dootripCompute->enqueueCapacityRecompute($entity);
  }
}


/**
 * Implements hook_entity_presave().
 */
function labdoo_dootrip_entity_presave(EntityInterface $entity) {
  if ($entity->bundle() !== 'dootrip') {
    return;
  }

  /** @var \Drupal\labdoo_dootrip\Service\Compute\DootripComputeInterface $dootripCompute */
  $dootripCompute = \Drupal::service('labdoo_dootrip.compute');
  $dootripCompute->setDootripTitle($entity);

  $laptopsChanged = labdoo_dootrip_has_any_field_changed($entity, ['field_laptops']);
  $locationsChanged = labdoo_dootrip_has_any_field_changed($entity, [
    'field_origin_of_the_trip',
    'field_destination_of_the_trip',
  ]);

  if ($laptopsChanged) {
    $dootripCompute->computeWeight($entity);
    $dootripCompute->computeDootronicsAssigned($entity);
    $dootripCompute->computeEdoovillagesAssigned($entity);
  }

  if ($laptopsChanged || $locationsChanged) {
    $dootripCompute->computeCo2Savings($entity);
  }

  if ($locationsChanged) {
    $dootripCompute->computeDistance($entity);
    $dootripCompute->computeDootripLocations($entity);
  }
}

function labdoo_dootrip_cron() {
  /** @var \Drupal\labdoo_dootrip\Service\Queue\Feeder\QueueFeederInterface $queueFeeder */
  $queueFeeder = \Drupal::service('labdoo_dootrip.queue.feeder.dootrip_capacity');
  $database = \Drupal::database();
  // The capacity worker uses DateTime::diff('%r%a') and only moves items
  // from transit to delivered after at least one full day has elapsed.
  $arrival_cutoff = (new \DateTime())->modify('-1 day')->format('Y-m-d\\TH:i:s');

  $query = $database->select('node_field_data', 'n');
  $query->distinct();
  $query->innerJoin(
    'node__field_arrival_date',
    'arrival',
    'arrival.entity_id = n.nid AND arrival.deleted = 0 AND arrival.langcode = n.langcode'
  );
  $query->innerJoin(
    'node__field_dootronics_in_transit',
    'transit',
    'transit.entity_id = n.nid AND transit.deleted = 0 AND transit.langcode = n.langcode'
  );
  $dootrip_nids = $query
    ->fields('n', ['nid'])
    ->condition('n.type', 'dootrip')
    ->condition('arrival.field_arrival_date_value', $arrival_cutoff, '<')
    ->condition('transit.field_dootronics_in_transit_value', 0, '>')
    ->execute()
    ->fetchCol();

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($dootrip_nids as $dootrip_nid) {
    $dootrip = $storage->load((int) $dootrip_nid);
    if ($dootrip && $dootrip->bundle() === 'dootrip') {
      $queueFeeder->feedQueue($dootrip);
    }
  }
}

/**
 * Implements hook_views_query_alter().
 */
function labdoo_dootrip_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == 'dootrips_dashboard') {
    $user_id = \Drupal::request()->query->get('u');
    $mine = \Drupal::request()->query->get('mine');

    if (!empty($user_id) && is_numeric($user_id)) {
      $query->addWhere('AND', 'node_field_data.uid', $user_id, '=');
    }
    elseif (!empty($mine) && (int) $mine === 1) {
      $query->addWhere('AND', 'node_field_data.uid', \Drupal::currentUser()->id(), '=');
    }
  }
}
