<?php

/**
 * @file
 * Install, update and uninstall functions for the Labdoo Dootrip module.
 */

use Drupal\Core\Cache\Cache;

/**
 * Keeps dootrip origin/destination visible during geocoder outages.
 */
function labdoo_dootrip_update_9002() {
  $display = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load('node.dootrip.default');
  if ($display) {
    foreach (['field_origin_of_the_trip', 'field_destination_of_the_trip'] as $field) {
      $component = $display->getComponent($field);
      if ($component && $component['type'] === 'geocoder_geofield_reverse_geocode') {
        $component['type'] = 'labdoo_dootrip_location';
        $display->setComponent($field, $component);
      }
    }
    $display->save();
  }
}

/**
 * Initialize field_expired to 0 for all dootrips.
 */
function labdoo_dootrip_update_9001() {
  // Set field_expired to 0 for all existing dootrip nodes.
  $database = \Drupal::database();

  // Insert missing records in bulk.
  $database->query("
    INSERT INTO {node__field_expired} (bundle, deleted, entity_id, revision_id, langcode, delta, field_expired_value)
    SELECT 'dootrip', 0, n.nid, n.vid, n.langcode, 0, 0
    FROM {node_field_data} n
    LEFT JOIN {node__field_expired} fe ON fe.entity_id = n.nid AND fe.langcode = n.langcode
    WHERE n.type = 'dootrip' AND fe.entity_id IS NULL
  ");

  $database->query("
    INSERT INTO {node_revision__field_expired} (bundle, deleted, entity_id, revision_id, langcode, delta, field_expired_value)
    SELECT 'dootrip', 0, n.nid, n.vid, n.langcode, 0, 0
    FROM {node_field_revision} n
    LEFT JOIN {node_revision__field_expired} fe ON fe.entity_id = n.nid AND fe.revision_id = n.vid AND fe.langcode = n.langcode
    WHERE n.nid IN (SELECT nid FROM {node_field_data} WHERE type = 'dootrip') AND fe.entity_id IS NULL
  ");

  // Update existing records to 0.
  $database->query("
    UPDATE {node__field_expired}
    SET field_expired_value = 0
    WHERE bundle = 'dootrip'
  ");

  $database->query("
    UPDATE {node_revision__field_expired}
    SET field_expired_value = 0
    WHERE bundle = 'dootrip'
  ");

  // Invalidate caches.
  Cache::invalidateTags(['node_list:dootrip', 'node:dootrip']);

  return t('Field field_expired configuration imported and initialized to 0 for all dootrips.');
}

/**
 * Increase the stored dootrip weight limit without truncating existing values.
 */
function labdoo_dootrip_update_9003() {
  $database = \Drupal::database();
  $table = 'node__field_dootrip_weight';
  if (!$database->schema()->tableExists($table)) {
    throw new RuntimeException('The dootrip weight field table is missing.');
  }

  $maximum_existing_value = (int) $database->query(
    'SELECT MAX(CHAR_LENGTH(field_dootrip_weight_value)) FROM {node__field_dootrip_weight} WHERE deleted = 0',
  )->fetchField();
  if ($maximum_existing_value > 255) {
    throw new RuntimeException(sprintf(
      'Cannot increase the dootrip weight field to 255 characters: an existing value has %d characters.',
      $maximum_existing_value,
    ));
  }

  \Drupal::configFactory()
    ->getEditable('field.storage.node.field_dootrip_weight')
    ->set('settings.max_length', 255)
    ->save();

  $field_manager = \Drupal::service('entity_field.manager');
  $field_manager->clearCachedFieldDefinitions();
  $definition = $field_manager->getFieldStorageDefinitions('node')['field_dootrip_weight'];
  // Existing values were checked above; the schema update widens the column.
  $definition->setSetting('column_changes_handled', TRUE);
  \Drupal::entityDefinitionUpdateManager()->updateFieldStorageDefinition($definition);

  // Do not retain the one-time schema-update override in installed metadata.
  $definition->setSetting('column_changes_handled', FALSE);
  \Drupal::service('entity.last_installed_schema.repository')->setLastInstalledFieldStorageDefinition($definition);

  return t('Increased the dootrip weight limit to 255 characters without truncating existing values.');
}
