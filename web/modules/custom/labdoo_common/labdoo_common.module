use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\user\UserInterface;
use Drupal\Core\Block\BlockPluginInterface;
use Drupal\file\FileInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Site\Settings;

/**
 * Implements hook_webform_element_alter().
 */
function labdoo_common_webform_element_alter(array &$element, FormStateInterface $form_state, array $context) {
  $build_info = $form_state->getBuildInfo();
  if (($build_info['form_id'] ?? '') !== 'webform_submission_contact_labdoo_add_form') {
    return;
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  $key = $element['#webform_key'] ?? '';

  // Handle Reason (re) mapping.
  if ($key === 'the_reason_you_are_contacting_labdoo_org') {
    $reason = $request->query->get('re');
    if ($reason !== null) {
      $mapping = [
        '0' => '1', // donate laptop
        '1' => '2', // dootrip
        '2' => '3', // volunteer
        '3' => '4', // edoovillage
        '4' => '5', // contact labdoo
      ];
      if (isset($mapping[$reason])) {
        $element['#default_value'] = $mapping[$reason];
      }
    }
    return;
  }

  // Handle Country (co) normalization.
  if ($key === 'country') {
    $co = $request->query->get('co'); // "es"
    if (!$co) {
      return;
    }

    $iso2 = strtoupper((string) $co); // "ES"

    // ISO2 -> Country name (ES => Spain).
    $countries = \Drupal::service('country_manager')->getList();
    if (empty($countries[$iso2])) {
      return;
    }

    $country_value = (string) $countries[$iso2];
    if (!isset($element['#default_value']) || !is_array($element['#default_value'])) {
      $element['#default_value'] = [];
    }

    $element['#default_value']['country'] = $country_value;

    if (isset($element['country']) && is_array($element['country'])) {
      $element['country']['#default_value'] = $country_value;
      $element['country']['#value'] = $country_value;
    }
  }
}

/**
 * Implements hook_token_info().
 */
function labdoo_common_token_info() {
  $info = [];

  $info['tokens']['custom']['get_parameters'] = [
    'name' => t('GET parameters'),
    'description' => t('Renders the GET parameters in the URL.'),
  ];

  return $info;
}

/**
 * Implements hook_tokens().
 */
function labdoo_common_tokens($type, $tokens, array $data = array(), array $options = array()) {
  $replacements = [];

  if (($type === 'custom') && isset($tokens['get_parameters'])) {
    $request = \Drupal::requestStack()->getCurrentRequest();
    if ($request) {
      $queryParams = $request->query->all();
      $replacements[$tokens['get_parameters']] = http_build_query($queryParams);
    }
  }

  return $replacements;
}

/**
 * Implements hook_user_presave().
 */
function labdoo_common_user_presave(UserInterface $account) {
  $account->set('field_username', $account->get('name')->value);
}

/**
 * Sets the active countries for the given form based on the provided context.
 *
 * Updates the country field options in the form with a filtered list of countries.
 *
 * @param array $form
 *   The form array where the active countries will be set.
 * @param string $context
 *   The context used to filter and retrieve the active countries.
 *
 * @return void
 */
function labdoo_common_set_active_countries(array &$form, string $context): void {
  /** @var \Drupal\labdoo_common\Service\Repository\CommonRepository $commonRepository */
  $commonRepository = \Drupal::service('labdoo_common.repository.common');
  $activeCountries = $commonRepository->getActiveCountries($context);
  $allCountries = $form['field_country_value']['#options'];
  $selectedCountries = array_intersect_key(
    $allCountries,
    array_flip($activeCountries)
  );
  $selectedCountries = array_merge(
    ['All' => t('- Any -')],
    $selectedCountries
  );
  $form['field_country_value']['#options'] = $selectedCountries;
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 */
function labdoo_common_form_user_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (isset($form['field_locations'])) {
    $form['field_locations']['widget'][0]['#after_build'][] = 'labdoo_common_field_locations_after_build';
  }
}

/**
 * After build callback for field_locations.
 */
function labdoo_common_field_locations_after_build(array $element, FormStateInterface $form_state) {
  if (isset($element['value']['map']['geocode'])) {
    $element['value']['map']['geocode']['#title'] = t('Enter your City/town/village');
    $element['value']['map']['geocode']['#description'] = t('Use this to geocode your search location. This will help other users to find your items.');
    $element['value']['map']['geocode']['#required'] = TRUE;
  }
  return $element;
}

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form.
 */
function labdoo_common_form_user_register_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  labdoo_common_form_user_form_alter($form, $form_state, $form_id);

  $required_fields = [
    'field_username',
    'field_user_name',
    'field_about_me',
    'field_skills',
    'field_locations',
    'timezone',
    'user_picture',
    'field_hub_manager_notifications',
  ];

  foreach ($required_fields as $field_name) {
    if (isset($form[$field_name])) {
      if (isset($form[$field_name]['widget'])) {
        $form[$field_name]['widget']['#required'] = TRUE;

        // For string fields and similar, we often need to set #required on the value element.
        if (isset($form[$field_name]['widget'][0]['value'])) {
          $form[$field_name]['widget'][0]['value']['#required'] = TRUE;
        }
        // For text_textarea (like field_about_me).
        elseif (isset($form[$field_name]['widget'][0]['#type']) && $form[$field_name]['widget'][0]['#type'] === 'text_textarea') {
          $form[$field_name]['widget'][0]['#required'] = TRUE;
        }
      }
      else {
        $form[$field_name]['#required'] = TRUE;
      }
    }
  }

  // Account fields like name and mail are usually required by default,
  // but if timezone is inside account:
  if (isset($form['account']['timezone'])) {
    $form['account']['timezone']['#required'] = TRUE;
  }
}

/**
 * Implements hook_block_view_alter().
 */
function labdoo_common_block_view_alter(array &$build, BlockPluginInterface $block) {
  // Check if this is the "Current mini-missions" block.
  if ($block->getPluginId() == 'views_block:actions-block_1') {
    // Attach our auto-rotation library.
    $build['#attached']['library'][] = 'labdoo_common/auto_rotate_mini_missions';
  }
}

/**
 * Implements hook_entity_insert().
 */
function labdoo_common_entity_insert(EntityInterface $entity) {
  if ($entity instanceof FieldableEntityInterface && !isset($entity->labdoo_skip_geocoding)) {
    \Drupal::service('labdoo_common.geocode_cache_manager')->storeEntityCoordinates($entity);
  }

  if ($entity instanceof FileInterface && str_starts_with($entity->getMimeType(), 'image/')) {
    foreach (ImageStyle::loadMultiple() as $style) {
      $style->createDerivative(
        $entity->getFileUri(),
        $style->buildUri($entity->getFileUri())
      );
    }
  }
}

/**
 * Implements hook_entity_update().
 */
function labdoo_common_entity_update(EntityInterface $entity) {
  if ($entity instanceof FieldableEntityInterface && !isset($entity->labdoo_skip_geocoding)) {
    \Drupal::service('labdoo_common.geocode_cache_manager')->storeEntityCoordinates($entity);
  }
}

/**
 * Implements hook_entity_presave().
 */
function labdoo_common_entity_presave(EntityInterface $entity) {
  // Disable geocoder_field if skip flag is present or the entity is syncing.
  if (
    !empty($entity->skip_geocoding_enqueue) ||
    !empty($entity->labdoo_skip_geocoding) ||
    (method_exists($entity, 'isSyncing') && $entity->isSyncing())
  ) {
    if (\Drupal::hasRequest()) {
      \Drupal::request()->attributes->set('geocoder_presave_disabled', TRUE);
    }
  }

  if ($entity instanceof FieldableEntityInterface && !isset($entity->labdoo_skip_geocoding) && !\Drupal::state()->get('labdoo_migrate_is_running', FALSE)) {
    \Drupal::service('labdoo_common.geocode_cache_manager')->applyCacheToEntity($entity);
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function labdoo_common_module_implements_alter(array &$implementations, string $hook) {
  if (
    ($hook !== 'entity_presave' && $hook !== 'reverse_geocode_entity_field_coordinates_alter' && $hook !== 'geocode_entity_field_address_string_alter' && $hook !== 'reverse_geocode_coordinates' && $hook !== 'geocode_address_string')
    || !isset($implementations['labdoo_common'])
  ) {
    return;
  }

  $group = ['labdoo_common' => $implementations['labdoo_common']];
  unset($implementations['labdoo_common']);
  $implementations = $group + $implementations;
}

/**
 * Implements hook_reverse_geocode_coordinates_alter().
 */
function labdoo_common_reverse_geocode_coordinates_alter(&$latitude, &$longitude) {
  if (
    \Drupal::state()->get('labdoo_migrate_is_running', FALSE)
    || (PHP_SAPI === 'cli' && str_contains(implode(' ', $_SERVER['argv']), 'labdoo_migrate_migration'))
    || \Drupal::state()->get('labdoo_geocoding_disabled', FALSE)
    || Settings::get('labdoo_geocoding_disabled', FALSE)
  ) {
    $latitude = NULL;
    $longitude = NULL;
    return;
  }

  // Ensure they are floats for the geocoder.
  $lat = (float) $latitude;
  $lon = (float) $longitude;

  // Prevent geocoding absurd coordinates (near 0,0).
  if (abs($lat) < 0.1 && abs($lon) < 0.1) {
    $latitude = NULL;
    $longitude = NULL;
    return;
  }

  // Pass back as floats.
  $latitude = $lat;
  $longitude = $lon;
}

/**
 * Implements hook_reverse_geocode_entity_field_coordinates_alter().
 */
function labdoo_common_reverse_geocode_entity_field_coordinates_alter(&$latitude, &$longitude, FieldItemListInterface $field) {
  // Prevent geocoding during migration or if explicitly disabled for this entity.
  $entity = $field->getEntity();
  if (
    isset($entity->labdoo_skip_geocoding)
    || \Drupal::state()->get('labdoo_migrate_is_running', FALSE)
    || (PHP_SAPI === 'cli' && str_contains(implode(' ', $_SERVER['argv'] ?? []), 'labdoo_migrate_migration'))
    || \Drupal::state()->get('labdoo_geocoding_disabled', FALSE)
    || Settings::get('labdoo_geocoding_disabled', FALSE)
  ) {
    $latitude = NULL;
    $longitude = NULL;
    return;
  }

  // Ensure they are floats for the geocoder.
  $lat = (float) $latitude;
  $lon = (float) $longitude;

  // Prevent geocoding absurd coordinates (near 0,0).
  if (abs($lat) < 0.1 && abs($lon) < 0.1) {
    // Setting them to NULL will make Geocoder skip the operation safely.
    $latitude = NULL;
    $longitude = NULL;
    return;
  }

  // Pass back as floats to avoid type errors in Geocoder\StatefulGeocoder::reverse().
  $latitude = $lat;
  $longitude = $lon;
}

/**
 * Implements hook_geocode_address_string_alter().
 */
function labdoo_common_geocode_address_string_alter(string &$address_string) {
  if (
    \Drupal::state()->get('labdoo_migrate_is_running', FALSE)
    || (PHP_SAPI === 'cli' && str_contains(implode(' ', $_SERVER['argv']), 'labdoo_migrate_migration'))
    || \Drupal::state()->get('labdoo_geocoding_disabled', FALSE)
  ) {
    $address_string = '';
    return;
  }

  // Prevent geocoding empty or absurdly short address strings.
  if (strlen(trim($address_string)) < 2) {
    $address_string = '';
  }
}

/**
 * Implements hook_geocode_entity_field_address_string_alter().
 */
function labdoo_common_geocode_entity_field_address_string_alter(string &$address_string, FieldItemListInterface $field) {
  // Prevent geocoding during migration or if explicitly disabled for this entity.
  $entity = $field->getEntity();
  if (
    isset($entity->labdoo_skip_geocoding)
    || \Drupal::state()->get('labdoo_migrate_is_running', FALSE)
    || (PHP_SAPI === 'cli' && str_contains(implode(' ', $_SERVER['argv']), 'labdoo_migrate_migration'))
    || \Drupal::state()->get('labdoo_geocoding_disabled', FALSE)
  ) {
    $address_string = '';
    return;
  }

  // Prevent geocoding empty or absurdly short address strings.
  if (strlen(trim($address_string)) < 2) {
    $address_string = '';
  }
}
