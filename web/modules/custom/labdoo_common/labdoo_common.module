    || \Drupal::state()->get('labdoo_geocoding_disabled', FALSE)
    || Settings::get('labdoo_geocoding_disabled', FALSE)
  ) {
    $address_string = '';
    return;
  }

  // Prevent geocoding empty or absurdly short address strings.
  if (strlen(trim($address_string)) < 2) {
    $address_string = '';
  }
}

/**
 * Implements hook_entity_extra_field_info().
 */
function labdoo_common_entity_extra_field_info() {
  $extra = [];
  $bundles = ['dootronic', 'dootrip', 'hub', 'edoovillage'];
  foreach ($bundles as $bundle) {
    $extra['node'][$bundle]['display']['labdoo_dates'] = [
      'label' => t('Labdoo: Created/Updated dates'),
      'description' => t('Displays the creation and last update dates.'),
      'weight' => 100,
      'visible' => TRUE,
    ];
  }
  return $extra;
}

/**
 * Implements hook_node_view().
 */
function labdoo_common_node_view(array &$build, EntityInterface $node, EntityViewDisplayInterface $display, $view_mode) {
  if ($view_mode === 'full' && $display->getComponent('labdoo_dates')) {
    $created = $node->getCreatedTime();
    $changed = $node->getChangedTime();

    /** @var \Drupal\Core\Datetime\DateFormatterInterface $dateFormatter */
    $dateFormatter = \Drupal::service('date.formatter');

    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    if ($langcode === 'en') {
      $format_tagged = 'm/d/Y';
      $format_updated = 'm/d/Y';
    }
    else {
      $format_tagged = 'd/m/y';
      $format_updated = 'd/m/y';
    }

    $created_label = ($node->bundle() === 'dootronic') ? t('Date it was tagged:') : t('Date it was created:');

    $build['labdoo_dates'] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['labdoo-dates-box']],
      'tagged' => [
        '#markup' => '<p><strong>' . $created_label . '</strong> ' . $dateFormatter->format($created, 'custom', (string) t($format_tagged)) . '</p>',
      ],
      'updated' => [
        '#markup' => '<p><strong>' . t('Date it was last updated:') . '</strong> ' . $dateFormatter->format($changed, 'custom', (string) t($format_updated)) . '</p>',
      ],
    ];
  }
}

/**
 * Implements hook_page_attachments().
 */
function labdoo_common_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'labdoo_common/media_library_admin';
}

/**
 * Implements hook_library_info_alter().
 */
function labdoo_common_library_info_alter(array &$libraries, string $extension) {
  if ($extension === 'geocoder' && isset($libraries['geocoder']['js']['js/geocoder.drupal.js'])) {
    unset($libraries['geocoder']['js']['js/geocoder.drupal.js']);
    $libraries['geocoder']['js']['/modules/custom/labdoo_common/js/geocoder.drupal.secure.js'] = [];
  }

  if ($extension === 'geofield_map' && isset($libraries['geocoder']['js']['js/geofield_map.geocoder.js'])) {
    unset($libraries['geocoder']['js']['js/geofield_map.geocoder.js']);
    $libraries['geocoder']['js']['/modules/custom/labdoo_common/js/geofield_map.geocoder.secure.js'] = [];
  }
}

/**
 * Implements hook_views_pre_render().
 */
function labdoo_common_views_pre_render(\Drupal\views\ViewExecutable $view) {
  if ($view->id() !== 'search_results') {
    return;
  }

  foreach ($view->result as $row) {
    if (!isset($row->_object) || !is_object($row->_object) || !method_exists($row->_object, 'getValue')) {
      continue;
    }

    $entity = $row->_object->getValue();
    if (!$entity) {
      continue;
    }

    // If the entity is a Node and its title is empty, construct a beautiful title.
    if ($entity instanceof \Drupal\node\NodeInterface && $entity->getTitle() === '') {
      $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $entity->id());
      $computed_title = '';
      if ($alias) {
        $bundle = $entity->bundle();
        if (preg_match('/' . preg_quote($bundle, '/') . '-([0-9]+)-(.*)/', $alias, $matches)) {
          $num = $matches[1];
          $parts = explode('-', $matches[2]);
          $formatted_parts = array_map('ucfirst', $parts);
          $computed_title = ucfirst($bundle) . ' #' . $num . ' - ' . implode(' ', $formatted_parts);
        }
        elseif (preg_match('/' . preg_quote($bundle, '/') . '-(.*)/', $alias, $matches)) {
          $parts = explode('-', $matches[1]);
          $formatted_parts = array_map('ucfirst', $parts);
          $computed_title = ucfirst($bundle) . ': ' . implode(' ', $formatted_parts);
        }
      }
      if ($computed_title === '') {
        $computed_title = ucfirst($entity->bundle()) . ' #' . $entity->id();
      }
      $entity->setTitle($computed_title);
    }
  }
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function labdoo_common_preprocess_views_view_field(&$variables) {
  $view = $variables['view'];
  if ($view->id() !== 'search_results') {
    return;
  }

  $field = $variables['field'];
  $row = $variables['row'];

  if (!isset($row->_object) || !is_object($row->_object) || !method_exists($row->_object, 'getValue')) {
    return;
  }

  $entity = $row->_object->getValue();
  if (!$entity) {
    return;
  }

  // Handle mini_wiki_page specific fields: type, created, changed.
  if ($entity->getEntityTypeId() === 'mini_wiki_page') {
    if ($field->field === 'type') {
      $variables['output'] = \Drupal\Core\Render\Markup::create((string) t('Wiki Page'));
    }
    elseif ($field->field === 'created') {
      $created_time = NULL;
      if (method_exists($entity, 'getCreatedTime')) {
        $created_time = $entity->getCreatedTime();
      }
      elseif ($entity->hasField('created') && !$entity->get('created')->isEmpty()) {
        $created_time = (int) $entity->get('created')->value;
      }

      if ($created_time) {
        $formatted = \Drupal::service('date.formatter')->format($created_time, 'medium');
        $variables['output'] = \Drupal\Core\Render\Markup::create($formatted);
      }
    }
    elseif ($field->field === 'changed') {
      $changed_time = NULL;
      if (method_exists($entity, 'getChangedTime')) {
        $changed_time = $entity->getChangedTime();
      }
      elseif ($entity->hasField('changed') && !$entity->get('changed')->isEmpty()) {
        $changed_time = (int) $entity->get('changed')->value;
      }

      if ($changed_time) {
        $formatted = \Drupal::service('date.formatter')->format($changed_time, 'medium');
        $variables['output'] = \Drupal\Core\Render\Markup::create($formatted);
      }
    }
  }
}
