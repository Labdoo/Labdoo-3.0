<?php

/**
 * @file
 * Install and update hooks for the Labdoo Common module.
 */

use Drupal\Core\Utility\UpdateException;

/**
 * Installs geocode cache entity schema and migrates legacy table rows.
 */
function labdoo_common_update_9001(): void {
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();
  $database = \Drupal::database();

  $entity_type = $entity_type_manager->getDefinition('labdoo_geocode_cache');
  $entity_definition_update_manager->installEntityType($entity_type);

  $schema = $database->schema();
  if (!$schema->tableExists('labdoo_common_geocode_cache')) {
    return;
  }

  $storage = $entity_type_manager->getStorage('labdoo_geocode_cache');
  $rows = $database->select('labdoo_common_geocode_cache', 'c')
    ->fields('c', [
      'address_normalized',
      'address_original',
      'latitude',
      'longitude',
      'provider',
      'hits',
      'created',
      'changed',
    ])
    ->execute();

  foreach ($rows as $row) {
    $entry = $storage->create([
      'address_normalized' => (string) $row->address_normalized,
      'address_original' => $row->address_original,
      'latitude' => (float) $row->latitude,
      'longitude' => (float) $row->longitude,
      'provider' => $row->provider,
      'hits' => (int) $row->hits,
      'created' => (int) $row->created,
      'changed' => (int) $row->changed,
    ]);
    $entry->save();
  }

  $schema->dropTable('labdoo_common_geocode_cache');
}

/**
 * Add performance indexes for slow queries.
 */
function labdoo_common_update_9002(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Index for labdoo_scraper_results (discovered_url).
  if ($schema->tableExists('labdoo_scraper_results')) {
    if (!$schema->indexExists('labdoo_scraper_results', 'labdoo_scraper_results__discovered_url')) {
      $schema->addIndex('labdoo_scraper_results', 'labdoo_scraper_results__discovered_url', ['discovered_url'], [
        'fields' => [
          'discovered_url' => ['type' => 'varchar', 'length' => 191],
        ],
      ]);
    }
  }

  // Index for node__field_stream_it (field_stream_it_value).
  if ($schema->tableExists('node__field_stream_it')) {
    if (!$schema->indexExists('node__field_stream_it', 'node__field_stream_it__value')) {
      $schema->addIndex('node__field_stream_it', 'node__field_stream_it__value', ['field_stream_it_value'], [
        'fields' => [
          'field_stream_it_value' => ['type' => 'int', 'size' => 'tiny'],
        ],
      ]);
    }
  }

  // Composite index for node_field_data (status, type, created).
  if ($schema->tableExists('node_field_data')) {
    if (!$schema->indexExists('node_field_data', 'node_field_data__status_type_created')) {
      $schema->addIndex('node_field_data', 'node_field_data__status_type_created', ['status', 'type', 'created'], [
        'fields' => [
          'status' => ['type' => 'int', 'size' => 'tiny'],
          'type' => ['type' => 'varchar', 'length' => 32],
          'created' => ['type' => 'int'],
        ],
      ]);
    }
    // Composite index for node_field_data (type, title).
    if (!$schema->indexExists('node_field_data', 'node_field_data__type_title')) {
      $schema->addIndex('node_field_data', 'node_field_data__type_title', ['type', ['title', 191]], [
        'fields' => [
          'title' => ['type' => 'varchar', 'length' => 255],
          'type' => ['type' => 'varchar', 'length' => 32],
        ],
      ]);
    }
  }
}

/**
 * Add more performance indexes for path_alias and node__field_location.
 */
function labdoo_common_update_9003(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Index for path_alias (status, langcode, id DESC) to optimize alias lookups and sorting.
  if ($schema->tableExists('path_alias')) {
    if (!$schema->indexExists('path_alias', 'path_alias__status_langcode_id')) {
      $schema->addIndex('path_alias', 'path_alias__status_langcode_id', ['status', 'langcode', 'id'], [
        'fields' => [
          'status' => ['type' => 'int', 'size' => 'tiny'],
          'langcode' => ['type' => 'varchar', 'length' => 12],
          'id' => ['type' => 'int', 'unsigned' => TRUE],
        ],
      ]);
    }
  }

  // Index for node__field_location to optimize filtering by field_location_value.
  if ($schema->tableExists('node__field_location')) {
    if (!$schema->indexExists('node__field_location', 'node__field_location__entity_id_value')) {
      $schema->addIndex('node__field_location', 'node__field_location__entity_id_value', ['entity_id', ['field_location_value', 1]], [
        'fields' => [
          'entity_id' => ['type' => 'int', 'unsigned' => TRUE],
          'field_location_value' => ['type' => 'blob'],
        ],
      ]);
    }
  }
}

/**
 * Reconcile field metadata and enable production asset aggregation.
 */
function labdoo_common_update_9004(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $repository = \Drupal::service('entity.last_installed_schema.repository');
  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('node');
  $installed = $repository->getLastInstalledFieldStorageDefinitions('node');

  // These fields already have populated tables. Only reconcile equivalent
  // column definitions; changing their data layout requires a separate update.
  $names = [
    'field_co2_savings_dootrip',
    'field_dootrip_weight',
    'field_project_manager_s_',
  ];
  foreach ($names as $name) {
    $definition = $definitions[$name] ?? NULL;
    $original = $installed[$name] ?? NULL;
    if (!$definition || !$original
      || $definition->getType() !== $original->getType()
      || $definition->getColumns() != $original->getColumns()
      || $definition->getCardinality() !== $original->getCardinality()
      || $definition->isRevisionable() !== $original->isRevisionable()
      || $definition->isTranslatable() !== $original->isTranslatable()) {
      throw new UpdateException('Unexpected storage layout for node.' . $name . '; manual review is required.');
    }
    $manager->updateFieldStorageDefinition($definition);
  }

  \Drupal::configFactory()->getEditable('system.performance')
    ->set('css.preprocess', TRUE)
    ->set('js.preprocess', TRUE)
    ->save();
}

/**
 * Link footer entries to their published pages and contact form.
 */
function labdoo_common_update_9005(): void {
  $menus = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $nodes = \Drupal::entityTypeManager()->getStorage('node');
  $wiki_pages = \Drupal::entityTypeManager()->getStorage('mini_wiki_page');

  // Resolve destinations by title and type so node IDs may differ by site.
  $about_pages = $wiki_pages->loadByProperties([
    'label' => 'About Labdoo',
    'status' => 1,
  ]);
  $about_page = reset($about_pages);
  $source_pages = $nodes->loadByProperties([
    'title' => 'source code and development team',
    'type' => 'team_post',
    'status' => 1,
  ]);
  $source_page = reset($source_pages);

  $destinations = [
    'About Labdoo' => $about_page ? '/wiki-page/' . $about_page->id() : NULL,
    'Source Code / Development Team' => $source_page ? '/node/' . $source_page->id() : NULL,
    'Contact Labdoo' => '/contact',
  ];

  foreach ($destinations as $title => $uri) {
    if (!$uri) {
      \Drupal::logger('labdoo_common')->warning('Footer update skipped for "%title": published destination was not found.', ['%title' => $title]);
      continue;
    }
    $links = $menus->loadByProperties([
      'menu_name' => $title === 'Contact Labdoo' ? 'footer-right' : 'footer-left',
      'title' => $title,
    ]);
    foreach ($links as $link) {
      $link->set('link', ['uri' => 'internal:' . $uri]);
      $link->save();
    }
  }
}
