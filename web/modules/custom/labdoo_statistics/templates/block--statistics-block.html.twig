<div id="block-statistics" class="block block-statistics-block-block block-inner">
    <div class="attribute"><a href="{{ dootronics_url }}"><span class="data">{{ dootronics_tagged|number_format(0, ','|t, '.'|t) }}</span> {{ 'Dootronics tagged'|t }}</a></div>
    <div class="attribute"><a href="{{ dootronics_url }}"><span class="data">{{ dootronics_delivered|number_format(0, ','|t, '.'|t) }}</span> {{ 'Delivered'|t }}</a></div>
    <div class="attribute"><a href="{{ edoovillages_url }}"><span class="data">{{ edoovillages|number_format(0, ','|t, '.'|t) }}</span> {{ 'Schools'|t }}</a></div>
    <div class="attribute"><a href="{{ edoovillages_url }}"><span class="data">{{ students|number_format(0, ','|t, '.'|t) }}</span> {{ 'Students'|t }}</a></div>
    <div class="attribute"><a href="{{ hubs_url }}"><span class="data">{{ hubs|number_format(0, ','|t, '.'|t) }}</span> {{ 'Hubs'|t }}</a></div>
    <div class="attribute"><a href="{{ dootronics_url }}"><span class="data">{{ co2|number_format(0, ','|t, '.'|t) }}</span> {{ 'Kg C02 saved'|t }}</a></div>
    <div class="attribute"><a href="{{ dootronics_url }}"><span class="data">{{ countries|number_format(0, ','|t, '.'|t) }}</span> {{ 'Countries'|t }}</a></div>
</div>
