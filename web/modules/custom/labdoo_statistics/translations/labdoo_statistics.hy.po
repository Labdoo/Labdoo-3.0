msgid "Advanced Insights & Analytics"
msgstr "Ընդլայնված պատկերացումներ և վերլուծություն"

msgid "Explore deeper metrics about Labdoo's global impact and operational efficiency."
msgstr "Բացահայտեք ավելի խորը մետրիկաներ Labdoo-ի գլոբալ ազդեցության և գործառնական արդյունավետության մասին:"

msgid "Platform Activity"
msgstr "Պլատֆորմի գործունեություն"

msgid "Labdoo has been active for"
